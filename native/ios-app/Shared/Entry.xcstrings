    "Qeno starts the task and tells you when it is done." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeno 开始做这个任务，做完后告诉你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeno 開始做這個任務，做完後告訴你。"
