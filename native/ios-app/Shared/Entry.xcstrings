        }
      }
    },
    "Qeno is busy. Wait for the current task to finish and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeno 正在忙，请等当前任务结束后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qeno 正在忙，請等目前的任務結束後再試。"
          }
        }
      }
    },
    "Choose a model in Qeno’s settings, then return to Split View and try again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先在 Qeno 的设置里选择模型，再回到分屏重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請先在 Qeno 的設定裡選擇模型，再回到分割顯示重試。"
          }
        }
      }
    },
    "Turn on Qeno with on-device automation, then open the two apps in Split View and run the shortcut again." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先打开 Qeno 并启用本机自动化，再将两个 App 摆成分屏，然后重新运行快捷指令。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先開啟 Qeno 並啟用裝置上的自動化，再以分割顯示開啟兩個 App，然後重新執行捷徑。"
          }
        }
      }
    },
    "Use Split View" : {
