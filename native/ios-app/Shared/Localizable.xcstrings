    "Apple\u2019s sign-in needs device headers that only Apple hardware makes. Qeno gets them from this anisette server. It never sees your Apple ID or password.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple \u7684\u767b\u5f55\u9700\u8981\u53ea\u6709 Apple \u786c\u4ef6\u624d\u80fd\u751f\u6210\u7684\u8bbe\u5907\u6807\u5934\u3002Qeno \u4ece\u6b64 anisette \u670d\u52a1\u5668\u83b7\u53d6\u8fd9\u4e9b\u6807\u5934\u3002\u670d\u52a1\u5668\u4e0d\u4f1a\u770b\u5230\u4f60\u7684 Apple ID \u6216\u5bc6\u7801\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple \u7684\u767b\u5165\u9700\u8981\u53ea\u6709 Apple \u786c\u9ad4\u624d\u80fd\u751f\u6210\u7684\u88dd\u7f6e\u6a19\u982d\u3002Qeno \u5f9e\u6b64 anisette \u4f3a\u670d\u5668\u7372\u53d6\u9019\u4e9b\u6a19\u982d\u3002\u4f3a\u670d\u5668\u4e0d\u6703\u770b\u5230\u4f60\u7684 Apple ID \u6216\u5bc6\u78bc\u3002"
          }
        }
      }
    },
