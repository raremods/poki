          "stringUnit": {
            "state": "translated",
            "value": "Set the voice bridge first. Tap here, or Qeno \u203a Voice and Speech."
          }
        }
      }
    },
    "Set up Qeno's model first (an OpenAI key talks fastest), or enter a voice bridge address from your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u8bbe\u7f6e Qeno \u7684\u6a21\u578b\uff08\u7528 OpenAI \u5bc6\u94a5\u5bf9\u8bdd\u6700\u5feb\uff09\uff0c\u6216\u8f93\u5165 Mac \u4e0a\u7684\u8bed\u97f3\u6865\u63a5\u5730\u5740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u8a2d\u5b9a Qeno \u7684\u6a21\u578b\uff08\u7528 OpenAI \u91d1\u9470\u5c0d\u8a71\u6700\u5feb\uff09\uff0c\u6216\u8f38\u5165 Mac \u4e0a\u7684\u8a9e\u97f3\u6a4b\u63a5\u5730\u5740\u3002"
          }
        }
      }
    },
