    "Optional steps continue without asking. Payments, deletions and actions in Wallet still need your confirmation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u9009\u6b65\u9aa4\u65e0\u9700\u8be2\u95ee\u76f4\u63a5\u7ee7\u7eed\u3002\u4ed8\u6b3e\u3001\u5220\u9664\u53ca\u201c\u94b1\u5305\u201d\u64cd\u4f5c\u4ecd\u9700\u4f60\u672c\u4eba\u786e\u8ba4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u9078\u6b65\u9a5f\u7121\u9700\u8a62\u554f\u76f4\u63a5\u7e7c\u7e8c\u3002\u4ed8\u6b3e\u3001\u522a\u9664\u53ca\u300c\u9322\u5305\u300d\u64cd\u4f5c\u4ecd\u9700\u4f60\u672c\u4eba\u78ba\u8a8d\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional steps continue without asking. Payments, deletions, and Wallet actions still require your confirmation."
          }
        }
      }
    },
    "Optional steps run automatically without asking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u975e\u5fc5\u9700\u6b65\u9aa4\u5c06\u81ea\u52a8\u6267\u884c\uff0c\u4e0d\u518d\u8be2\u95ee\u3002"
