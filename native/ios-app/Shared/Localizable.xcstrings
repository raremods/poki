          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u756b\u9762\u9700\u4f60\u89aa\u81ea\u64cd\u4f5c\uff0c\u667a\u6167\u9ad4\u7b49\u5f85\u4e2d\u3002"
