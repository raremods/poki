    "Connection lost (%@). Nothing is sent again. Reconnect to hear how running steps ended.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u91cd\u65b0\u8fde\u63a5\u4ee5\u83b7\u53d6\u5f53\u524d\u6b65\u9aa4\u7ed3\u679c\u3002\u8fde\u63a5\u5df2\u65ad\u5f00\uff08%@\uff09\uff0c\u672a\u91cd\u590d\u53d1\u9001\u8bf7\u6c42\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u91cd\u65b0\u9023\u7dda\u4ee5\u53d6\u5f97\u76ee\u524d\u6b65\u9a5f\u7d50\u679c\u3002\u9023\u7dda\u5df2\u4e2d\u65b7\uff08%@\uff09\uff0c\u672a\u91cd\u8907\u50b3\u9001\u8acb\u6c42\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to hear how running steps finished. Connection lost (%@); nothing was resent."
          }
        }
      }
    },
    "Connection lost (%lld). Nothing is sent again. Reconnect to hear how running steps ended.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u91cd\u65b0\u8fde\u63a5\u4ee5\u83b7\u53d6\u5f53\u524d\u6b65\u9aa4\u7ed3\u679c\u3002\u8fde\u63a5\u5df2\u65ad\u5f00\uff08%lld\uff09\uff0c\u672a\u91cd\u590d\u53d1\u9001\u8bf7\u6c42\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u91cd\u65b0\u9023\u7dda\u4ee5\u53d6\u5f97\u76ee\u524d\u6b65\u9a5f\u7d50\u679c\u3002\u9023\u7dda\u5df2\u4e2d\u65b7\uff08%lld\uff09\uff0c\u672a\u91cd\u8907\u50b3\u9001\u8acb\u6c42\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to hear how running steps finished. Connection lost (%lld); nothing was resent."
          }
        }
      }
    },
    "Connection lost. Nothing is sent again. Talk again to hear how running steps ended.": {
