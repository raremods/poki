    "No extra app needed. Qeno connects only to this iPhone. Your normal traffic and DNS stay on their usual routes. iOS shows it as a VPN, so it may disconnect another VPN app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u9700\u989d\u5916 App\u3002Qeno \u53ea\u8fde\u63a5\u6b64 iPhone\u3002\u4f60\u5e73\u5e38\u7684\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u6765\u7684\u8def\u7ebf\u3002iOS \u4f1a\u5c06\u5b83\u663e\u793a\u4e3a VPN\uff0c\u56e0\u6b64\u53ef\u80fd\u4f1a\u65ad\u5f00\u5176\u4ed6 VPN App\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u9700\u984d\u5916 App\u3002Qeno \u53ea\u9023\u7dda\u6b64 iPhone\u3002\u4f60\u5e73\u5e38\u7684\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u4f86\u7684\u8def\u7dda\u3002iOS \u6703\u5c07\u5b83\u986f\u793a\u70ba VPN\uff0c\u56e0\u6b64\u53ef\u80fd\u6703\u65b7\u958b\u5176\u4ed6 VPN App\u3002"
          }
        }
      }
    },
    "No extra app needed. Qeno connects only to this iPhone; your normal internet traffic and DNS stay on their usual routes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u9700\u989d\u5916 App\u3002Qeno \u53ea\u8fde\u63a5\u6b64 iPhone\uff0c\u4f60\u5e73\u5e38\u7684\u7f51\u7edc\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u6765\u7684\u8def\u7ebf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u9700\u984d\u5916 App\u3002Qeno \u53ea\u9023\u7dda\u6b64 iPhone\uff0c\u4f60\u5e73\u5e38\u7684\u7db2\u8def\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u4f86\u7684\u8def\u7dda\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No extra app needed. Qeno connects only to this iPhone. Your normal internet traffic and DNS stay on their usual routes."
          }
        }
      }
    },
    "No extra app needed. Qeno connects only to this iPhone; your normal traffic and DNS stay on their usual routes. iOS shows it as a VPN, so it may disconnect another VPN app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No extra app needed. Qeno connects only to this iPhone; your normal traffic and DNS stay on their usual routes. iOS shows it as a VPN, so it may disconnect another VPN app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u9700\u989d\u5916\u5e94\u7528\u3002Qeno \u4ec5\u8fde\u63a5\u6b64 iPhone \u672c\u673a\uff0c\u65e5\u5e38\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u6709\u7ebf\u8def\u3002iOS \u4f1a\u5c06\u5176\u663e\u793a\u4e3a VPN\uff0c\u5f00\u542f\u65f6\u53ef\u80fd\u4f1a\u65ad\u5f00\u5176\u4ed6 VPN \u5e94\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u9700\u984d\u5916\u61c9\u7528\u7a0b\u5f0f\u3002Qeno \u50c5\u9023\u7dda\u6b64 iPhone \u672c\u6a5f\uff0c\u65e5\u5e38\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u6709\u7dda\u8def\u3002iOS \u6703\u5c07\u5176\u986f\u793a\u70ba VPN\uff0c\u958b\u555f\u6642\u53ef\u80fd\u6703\u4e2d\u65b7\u5176\u4ed6 VPN \u61c9\u7528\u7a0b\u5f0f\u3002"
          }
        }
      }
    },
    "No interface has a 10.7.0.x address. Check that your proxy app is on and its loopback module is enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u786e\u8ba4\u4ee3\u7406 App \u5df2\u5f00\u542f\u4e14\u5df2\u542f\u7528\u56de\u73af\u6a21\u5757\u3002\u5f53\u524d\u65e0 10.7.0.x \u63a5\u53e3\u5730\u5740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u78ba\u8a8d\u4ee3\u7406 App \u5df2\u958b\u555f\u4e14\u5df2\u555f\u7528\u8ff4\u74b0\u6a21\u7d44\u3002\u76ee\u524d\u7121 10.7.0.x \u4ecb\u9762\u4f4d\u5740\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check that your proxy app is on and its loopback module is enabled. No interface has a 10.7.0.x address."
          }
        }
      }
    },
