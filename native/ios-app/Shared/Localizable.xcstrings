    "To download updates by itself, Qeno needs your Apple Account. Sign in under Signing Options. Or update Qeno from Qeno Setup on your Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u201c\u7b7e\u540d\u9009\u9879\u201d\u4e2d\u767b\u5f55 Apple \u8d26\u6237\u5373\u53ef\u81ea\u52a8\u4e0b\u8f7d\u66f4\u65b0\uff0c\u4e5f\u53ef\u901a\u8fc7 Mac \u4e0a\u7684 Qeno Setup \u66f4\u65b0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u300c\u7c3d\u540d\u9078\u9805\u300d\u4e2d\u767b\u5165 Apple \u5e33\u865f\u5373\u53ef\u81ea\u52d5\u4e0b\u8f09\u66f4\u65b0\uff0c\u4e5f\u53ef\u900f\u904e Mac \u4e0a\u7684 Qeno Setup \u66f4\u65b0\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to your Apple Account under Signing Options so Qeno can download updates automatically, or update via Qeno Setup on your Mac."
          }
        }
      }
    },
    "To download updates by itself, Qeno needs your Apple Account: sign in under Signing Options. Or update Qeno from Qeno Setup on your Mac.": {
      "extractionState": "manual",
