        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u52ff\u624b\u52a8\u6253\u5f00 Qeno Runner\u3002\u667a\u80fd\u4f53\u9700\u8981\u65f6 Qeno \u4f1a\u81ea\u52a8\u542f\u52a8\u5b83\u3002"
