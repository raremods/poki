      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96a7\u9053\u5df2\u5f00\uff0c\u65e0\u5e94\u7b54"
          }
        }
      }
    },
    "Turn On": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u5f00"
