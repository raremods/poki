      }
    },
    "Keep Background App Refresh on for Qeno. With it off, iOS stops Qeno soon after it leaves the screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4e3a Qeno \u5f00\u542f\u201c\u540e\u53f0 App \u5237\u65b0\u201d\uff0c\u907f\u514d\u79bb\u5f00\u5e94\u7528\u540e\u88ab iOS \u6302\u8d77\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u70ba Qeno \u958b\u555f\u300c\u80cc\u666f App \u91cd\u65b0\u6574\u7406\u300d\uff0c\u907f\u514d\u96e2\u958b\u61c9\u7528\u7a0b\u5f0f\u5f8c\u88ab iOS \u66ab\u505c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Background App Refresh on for Qeno so iOS doesn\u2019t suspend it when you leave the app."
          }
        }
      }
    },
    "Keep Clash Mi connected. Users report this works on iOS 26.3 and failed on 26.4. The check above tells.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301 Clash Mi \u8fde\u63a5\u3002\u636e\u7528\u6237\u53cd\u9988\uff0c\u6b64\u65b9\u6cd5\u5728 iOS 26.3 \u4e0a\u53ef\u7528\uff0c\u5728 26.4 \u4e0a\u5931\u8d25\u3002\u4ee5\u4e0a\u65b9\u7684\u68c0\u67e5\u7ed3\u679c\u4e3a\u51c6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u6301 Clash Mi \u9023\u7dda\u3002\u64da\u4f7f\u7528\u8005\u53cd\u994b\uff0c\u6b64\u65b9\u6cd5\u5728 iOS 26.3 \u4e0a\u53ef\u7528\uff0c\u5728 26.4 \u4e0a\u5931\u6557\u3002\u4ee5\u4e0a\u65b9\u7684\u6aa2\u67e5\u7d50\u679c\u70ba\u6e96\u3002"
