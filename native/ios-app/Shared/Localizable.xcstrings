    "Location Services is off for Qeno, so iOS will suspend it shortly after you leave the app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4e3a Qeno \u5f00\u542f\u5b9a\u4f4d\u670d\u52a1\uff0c\u907f\u514d\u79bb\u5f00 App \u540e\u88ab iOS \u6302\u8d77\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u70ba Qeno \u958b\u555f\u5b9a\u4f4d\u670d\u52d9\uff0c\u907f\u514d\u96e2\u958b App \u5f8c\u88ab iOS \u66ab\u505c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Location Services for Qeno so iOS doesn\u2019t suspend it in the background."
          }
        }
      }
    },
    "Location Services is off for Qeno. It keeps itself running with silent audio, which iOS may stop during calls or other audio.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u7684\u5b9a\u4f4d\u670d\u52a1\u5df2\u5173\u95ed\u3002\u5b83\u6539\u7528\u9759\u97f3\u97f3\u9891\u4fdd\u6301\u8fd0\u884c\uff0c\u901a\u8bdd\u6216\u64ad\u653e\u5176\u4ed6\u97f3\u9891\u65f6 iOS \u53ef\u80fd\u4f1a\u505c\u6b62\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u7684\u5b9a\u4f4d\u670d\u52d9\u5df2\u95dc\u9589\u3002\u5b83\u6539\u7528\u975c\u97f3\u97f3\u8a0a\u4fdd\u6301\u57f7\u884c\uff0c\u901a\u8a71\u6216\u64ad\u653e\u5176\u4ed6\u97f3\u8a0a\u6642 iOS \u53ef\u80fd\u6703\u505c\u6b62\u5b83\u3002"
          }
        }
      }
    },
    "Location allowed. Qeno stays active in the background and never records your location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5141\u8bb8\u4f4d\u7f6e\u8bbf\u95ee\u3002Qeno \u4f1a\u5728\u540e\u53f0\u4fdd\u6301\u8fd0\u884c\uff0c\u7edd\u4e0d\u8bb0\u5f55\u4f4d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5141\u8a31\u4f4d\u7f6e\u53d6\u7528\u3002Qeno \u6703\u5728\u80cc\u666f\u4fdd\u6301\u57f7\u884c\uff0c\u7d55\u4e0d\u8a18\u9304\u4f4d\u7f6e\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location allowed. Qeno stays active in the background and never records your location."
          }
        }
      }
    },
