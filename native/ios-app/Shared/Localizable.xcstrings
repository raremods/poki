    "Live Activities are off for Qeno. Turn them on to view agent steps and approve sensitive actions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4e3a Qeno \u5f00\u542f\u5b9e\u65f6\u6d3b\u52a8\uff0c\u4ee5\u67e5\u770b\u667a\u80fd\u4f53\u6b65\u9aa4\u5e76\u6279\u51c6\u654f\u611f\u64cd\u4f5c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u70ba Qeno \u958b\u555f\u5373\u6642\u52d5\u614b\uff0c\u4ee5\u6aa2\u8996\u667a\u6167\u9ad4\u6b65\u9a5f\u4e26\u6279\u51c6\u654f\u611f\u64cd\u4f5c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Live Activities for Qeno to view agent steps and approve sensitive actions."
          }
        }
