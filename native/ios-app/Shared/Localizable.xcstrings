            "state": "translated",
            "value": "\u8bf7\u5148\u914d\u7f6e\u8bed\u97f3\u6865\u63a5\u3002\u8f7b\u70b9\u6b64\u5904\uff0c\u6216\u524d\u5f80\u201cQeno\u201d\u203a\u201c\u8bed\u97f3\u4e0e\u6717\u8bfb\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u914d\u7f6e\u8a9e\u97f3\u6a4b\u63a5\u3002\u8f15\u9ede\u6b64\u8655\uff0c\u6216\u524d\u5f80\u300cQeno\u300d\u203a\u300c\u8a9e\u97f3\u8207\u6717\u8b80\u300d\u3002"
