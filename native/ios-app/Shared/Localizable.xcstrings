    "Mounting the developer disk image timed out. Qeno needs the internet once after each restart to get Apple's signature; check Wi-Fi or cellular. Qeno tries again by itself.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u68c0\u67e5 Wi-Fi \u6216\u8702\u7a9d\u7f51\u7edc\u3002\u88c5\u8f7d\u5f00\u53d1\u8005\u78c1\u76d8\u6620\u50cf\u8d85\u65f6\uff1b\u91cd\u542f\u540e\u9700\u8054\u7f51\u4e00\u6b21\u83b7\u53d6 Apple \u7b7e\u540d\uff0cQeno \u4f1a\u81ea\u52a8\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u6aa2\u67e5 Wi-Fi \u6216\u884c\u52d5\u7db2\u8def\u3002\u88dd\u8f09\u958b\u767c\u8005\u78c1\u789f\u6620\u50cf\u903e\u6642\uff1b\u91cd\u555f\u5f8c\u9700\u9023\u7db2\u4e00\u6b21\u53d6\u5f97 Apple \u7c3d\u540d\uff0cQeno \u6703\u81ea\u52d5\u91cd\u8a66\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Wi-Fi or cellular. Mounting the developer disk image timed out; Qeno needs internet once after a restart for Apple\u2019s signature and retries automatically."
          }
        }
      }
    },
