    "%lld is chosen, but nothing answers at 10.7.0.1 right now. Open %@, make sure it is connected with the loopback on, then come back. This page updates by itself.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u9009\u62e9 %lld\uff0c\u4f46 10.7.0.1 \u65e0\u5e94\u7b54\u3002\u8bf7\u6253\u5f00 %@\uff0c\u786e\u8ba4\u5df2\u5f00\u542f\u56de\u73af\u5e76\u8fde\u63a5\u540e\u518d\u8fd4\u56de\uff0c\u72b6\u6001\u4f1a\u81ea\u52a8\u66f4\u65b0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u9078\u64c7 %lld\uff0c\u4f46 10.7.0.1 \u7121\u61c9\u7b54\u3002\u8acb\u958b\u555f %@\uff0c\u78ba\u8a8d\u5df2\u958b\u555f\u8ff4\u74b0\u4e26\u9023\u7dda\u5f8c\u518d\u8fd4\u56de\uff0c\u72c0\u614b\u6703\u81ea\u52d5\u66f4\u65b0\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld is selected, but 10.7.0.1 isn\u2019t answering. Open %@, connect with Loopback on, then return here. Status updates automatically."
          }
        }
      }
    },
    "%lld is chosen, but nothing answers at 10.7.0.1 right now. Open %lld, make sure it is connected with the loopback on, then come back. This page updates by itself.": {
