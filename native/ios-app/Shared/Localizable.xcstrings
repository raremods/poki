    "Ask for Everything. Nothing is approved automatically. Steps that follow straight after your answer in the same app do not ask again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5168\u90e8\u8be2\u95ee\u3002\u4e0d\u4f1a\u81ea\u52a8\u6279\u51c6\u4efb\u4f55\u6b65\u9aa4\u3002\u5728\u540c\u4e00 App \u4e2d\u7d27\u63a5\u4f60\u56de\u7b54\u4e4b\u540e\u7684\u6b65\u9aa4\u4e0d\u4f1a\u518d\u6b21\u8be2\u95ee\u3002"
