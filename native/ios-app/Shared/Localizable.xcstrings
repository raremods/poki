    "Gives Qeno its own key to this iPhone. Made and kept on the phone, no computer needed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives Qeno its own pairing key on this iPhone, generated and stored locally with no computer required."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64 iPhone \u672c\u673a\u751f\u6210\u5e76\u4fdd\u5b58\u4e13\u5c5e\u914d\u5bf9\u5bc6\u94a5\uff0c\u65e0\u9700\u7535\u8111\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64 iPhone \u672c\u6a5f\u7522\u751f\u4e26\u5132\u5b58\u5c08\u5c6c\u914d\u5c0d\u91d1\u9470\uff0c\u7121\u9700\u96fb\u8166\u3002"
          }
        }
      }
    },
    "Gives Qeno its own key to this iPhone. On this iOS version the key is made on a computer with Qeno Setup, then sent here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gives Qeno its own pairing key. On this iOS version, create it with Qeno Setup on a computer and send it here."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a Qeno \u914d\u7f6e\u4e13\u5c5e\u914d\u5bf9\u5bc6\u94a5\u3002\u5f53\u524d iOS \u7248\u672c\u9700\u901a\u8fc7\u7535\u8111\u4e0a\u7684 Qeno Setup \u751f\u6210\u540e\u53d1\u81f3\u6b64\u624b\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba Qeno \u8a2d\u5b9a\u5c08\u5c6c\u914d\u5c0d\u91d1\u9470\u3002\u76ee\u524d iOS \u7248\u672c\u9700\u900f\u904e\u96fb\u8166\u4e0a\u7684 Qeno Setup \u7522\u751f\u5f8c\u50b3\u81f3\u6b64\u624b\u6a5f\u3002"
          }
        }
      }
    },
    "Gives Qeno its own key to this iPhone. The key stays on this device.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a Qeno \u751f\u6210\u8bbf\u95ee\u6b64 iPhone \u7684\u4e13\u5c5e\u5bc6\u94a5\u3002\u5bc6\u94a5\u4ec5\u4fdd\u7559\u5728\u672c\u673a\u4e0a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba Qeno \u751f\u6210\u8a2a\u554f\u6b64 iPhone \u7684\u5c08\u5c6c\u91d1\u9470\u3002\u91d1\u9470\u50c5\u4fdd\u7559\u5728\u672c\u6a5f\u4e0a\u3002"
          }
        }
      }
    },
