          }
        }
      }
    },
    "The model Qeno\u2019s chat and voice use on this iPhone. Memory holds the routines and notes every agent shares.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u5728\u6b64 iPhone \u4e0a\u7528\u4e8e\u5bf9\u8bdd\u548c\u8bed\u97f3\u7684\u6a21\u578b\u3002\u201c\u8bb0\u5fc6\u201d\u4fdd\u5b58\u6240\u6709\u667a\u80fd\u4f53\u5171\u4eab\u7684\u6d41\u7a0b\u4e0e\u5907\u5fd8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u5728\u6b64 iPhone \u4e0a\u7528\u65bc\u5c0d\u8a71\u548c\u8a9e\u97f3\u7684\u6a21\u578b\u3002\u300c\u8a18\u61b6\u300d\u5132\u5b58\u6240\u6709\u667a\u6167\u9ad4\u5171\u4eab\u7684\u6d41\u7a0b\u8207\u5099\u5fd8\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model used for Qeno\u2019s chat and voice on this iPhone. Memory stores routines and notes shared across agents."
          }
        }
      }
    },
