          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u53ef\u5728\u6b64 iPhone \u4e0a\u9ede\u6309\u3001\u8f38\u5165\u548c\u6ed1\u52d5\u3002"
          }
        }
      }
    },
    "Qeno can't reach this iPhone. Check in this order: Setup \u203a Loopback (your proxy app or LocalDevVPN is connected, with 10.7.0.1 set), then Setup \u203a Pairing (pair again with the loopback on), then Developer Mode in Settings \u2192 Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4f9d\u6b21\u68c0\u67e5\uff1a\u201c\u914d\u7f6e \u203a \u56de\u73af\u201d\uff08LocalDevVPN \u6216\u4ee3\u7406\u5df2\u8fde\u63a5\u4e14\u914d\u597d 10.7.0.1\uff09\u3001\u201c\u914d\u7f6e \u203a \u914d\u5bf9\u201d\uff08\u5f00\u542f\u56de\u73af\u540e\u91cd\u914d\uff09\u3001\u201c\u8bbe\u7f6e \u203a \u9690\u79c1\u4e0e\u5b89\u5168\u201d\u4e2d\u7684\u5f00\u53d1\u8005\u6a21\u5f0f\u3002Qeno \u65e0\u6cd5\u8fde\u63a5\u6b64 iPhone\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u4f9d\u5e8f\u6aa2\u67e5\uff1a\u300c\u8a2d\u5b9a\u7cbe\u9748 \u203a \u8ff4\u74b0\u300d\uff08LocalDevVPN \u6216\u4ee3\u7406\u5df2\u9023\u7dda\u4e14\u914d\u597d 10.7.0.1\uff09\u3001\u300c\u8a2d\u5b9a\u7cbe\u9748 \u203a \u914d\u5c0d\u300d\uff08\u958b\u555f\u8ff4\u74b0\u5f8c\u91cd\u914d\uff09\u3001\u300c\u8a2d\u5b9a \u203a \u96b1\u79c1\u6b0a\u8207\u5b89\u5168\u6027\u300d\u4e2d\u7684\u958b\u767c\u8005\u6a21\u5f0f\u3002Qeno \u7121\u6cd5\u9023\u63a5\u6b64 iPhone\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Setup \u203a Loopback (LocalDevVPN or proxy connected with 10.7.0.1), then pair again in Setup \u203a Pairing, then check Developer Mode in Settings \u203a Privacy & Security. Qeno can\u2019t reach this iPhone."
          }
        }
      }
    },
    "Qeno can't reach this iPhone. Turn on the loopback, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5f00\u542f\u56de\u73af\u518d\u91cd\u8bd5\u3002Qeno \u65e0\u6cd5\u8fde\u63a5\u6b64 iPhone\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u958b\u555f\u8ff4\u74b0\u518d\u91cd\u8a66\u3002Qeno \u7121\u6cd5\u9023\u7dda\u6b64 iPhone\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Loopback, then try again. Qeno can\u2019t reach this iPhone."
          }
        }
      }
    },
    "Qeno can't use the microphone. Allow it in Settings, Privacy, Microphone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u201c\u8bbe\u7f6e \u203a \u9690\u79c1\u4e0e\u5b89\u5168 \u203a \u9ea6\u514b\u98ce\u201d\u4e2d\u5141\u8bb8\u8bbf\u95ee\u9ea6\u514b\u98ce\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u300c\u8a2d\u5b9a \u203a \u96b1\u79c1\u6b0a\u8207\u5b89\u5168\u6027 \u203a \u9ea5\u514b\u98a8\u300d\u4e2d\u5141\u8a31\u53d6\u7528\u9ea5\u514b\u98a8\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in Settings \u203a Privacy & Security \u203a Microphone."
          }
        }
      }
    },
    "Qeno cannot access the keychain and has no relay key yet. Reinstall Qeno with your signing tool, then reopen Settings.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u7528\u7b7e\u540d\u5de5\u5177\u91cd\u65b0\u5b89\u88c5 Qeno \u540e\u518d\u6253\u5f00\u8bbe\u7f6e\u3002Qeno \u65e0\u6cd5\u8bbf\u95ee\u94a5\u5319\u4e32\u4ee5\u751f\u6210\u4e2d\u8f6c\u5bc6\u94a5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u7528\u7c3d\u540d\u5de5\u5177\u91cd\u65b0\u5b89\u88dd Qeno \u5f8c\u518d\u958b\u555f\u8a2d\u5b9a\u3002Qeno \u7121\u6cd5\u53d6\u7528\u9470\u5319\u5708\u4ee5\u7522\u751f\u4e2d\u8f49\u91d1\u9470\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reinstall Qeno with your signing tool, then reopen Settings. Qeno can\u2019t access Keychain to create a relay key."
          }
        }
      }
    },
    "Qeno cannot start the usual way because the local connection is off. Turn the loopback on in your proxy app, or start anyway with iOS\u2019s automation banner showing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u4ee3\u7406 App \u4e2d\u5f00\u542f\u56de\u73af\uff0c\u6216\u5141\u8bb8\u663e\u793a iOS \u81ea\u52a8\u5316\u6a2a\u5e45\u76f4\u63a5\u542f\u52a8\u3002\u672c\u673a\u8fde\u63a5\u5f53\u524d\u5df2\u5173\u95ed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u4ee3\u7406 App \u4e2d\u958b\u555f\u8ff4\u74b0\uff0c\u6216\u5141\u8a31\u986f\u793a iOS \u81ea\u52d5\u5316\u6a6b\u5e45\u76f4\u63a5\u555f\u52d5\u3002\u672c\u6a5f\u9023\u7dda\u76ee\u524d\u5df2\u95dc\u9589\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Loopback in your proxy app, or start with the iOS automation banner visible. Local Connection is currently off."
          }
        }
      }
    },
    "Qeno cannot start the usual way without Wi-Fi. Connect to Wi-Fi, or start anyway with iOS\u2019s automation banner showing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u8fde\u63a5 Wi-Fi\uff0c\u6216\u5141\u8bb8\u663e\u793a iOS \u81ea\u52a8\u5316\u6a2a\u5e45\u76f4\u63a5\u542f\u52a8\u3002\u5e38\u89c4\u542f\u52a8\u9700\u8981 Wi-Fi\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u9023\u7dda Wi-Fi\uff0c\u6216\u5141\u8a31\u986f\u793a iOS \u81ea\u52d5\u5316\u6a6b\u5e45\u76f4\u63a5\u555f\u52d5\u3002\u5e38\u898f\u555f\u52d5\u9700\u8981 Wi-Fi\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to Wi-Fi, or start with the iOS automation banner visible. Standard startup requires Wi-Fi."
          }
        }
      }
    },
    "Qeno can\u2019t act yet: Developer Mode is off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5f00\u542f\u5f00\u53d1\u8005\u6a21\u5f0f\uff0cQeno \u624d\u80fd\u6267\u884c\u64cd\u4f5c\u3002"
