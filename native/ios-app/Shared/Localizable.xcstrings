    "To finish the update, swipe up on Qeno in the app switcher to close it, then open Qeno again. If the update is still available, try again. Features are unavailable until you reopen Qeno.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To finish the update, swipe up on Qeno in the app switcher to close it, then open Qeno again. If the update is still available, try again. Features are unavailable until you reopen Qeno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u591a\u4efb\u52a1\u754c\u9762\u5411\u4e0a\u5212\u6389 Qeno\uff0c\u7136\u540e\u91cd\u65b0\u6253\u5f00\u4ee5\u5b8c\u6210\u66f4\u65b0\u3002\u5982\u679c\u4ecd\u663e\u793a\u53ef\u7528\u66f4\u65b0\uff0c\u8bf7\u91cd\u8bd5\u3002\u91cd\u65b0\u6253\u5f00\u524d\uff0c\u529f\u80fd\u6682\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u591a\u5de5\u8655\u7406\u756b\u9762\u5411\u4e0a\u6ed1\u6389 Qeno\uff0c\u7136\u5f8c\u91cd\u65b0\u958b\u555f\u4ee5\u5b8c\u6210\u66f4\u65b0\u3002\u5982\u679c\u4ecd\u986f\u793a\u53ef\u7528\u66f4\u65b0\uff0c\u8acb\u91cd\u8a66\u3002\u91cd\u65b0\u958b\u555f\u524d\uff0c\u529f\u80fd\u66ab\u4e0d\u53ef\u7528\u3002"
          }
        }
      }
    },
