          }
        }
      }
    },
    "Optional, for live voice without an OpenAI key on this iPhone. Run bin/voice-bridge.mjs on your Mac and enter the address it gives.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u9009\uff0c\u7528\u4e8e\u672c\u673a\u672a\u914d\u7f6e OpenAI \u5bc6\u94a5\u65f6\u5f00\u542f\u5b9e\u65f6\u8bed\u97f3\u3002\u5728 Mac \u4e0a\u8fd0\u884c bin/voice-bridge.mjs \u5e76\u8f93\u5165\u8f93\u51fa\u7684\u5730\u5740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u9078\uff0c\u7528\u65bc\u672c\u6a5f\u672a\u8a2d\u5b9a OpenAI \u91d1\u9470\u6642\u958b\u555f\u5373\u6642\u8a9e\u97f3\u3002\u5728 Mac \u4e0a\u57f7\u884c bin/voice-bridge.mjs \u4e26\u8f38\u5165\u8f38\u51fa\u7684\u4f4d\u5740\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional, for Live Voice without an OpenAI key on this iPhone. Run bin/voice-bridge.mjs on your Mac and enter the address it prints."
          }
        }
      }
    },
