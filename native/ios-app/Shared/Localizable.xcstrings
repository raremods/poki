        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u958b\u555f\u958b\u767c\u8005\u6a21\u5f0f\uff0c\u8def\u5f91\u662f\u8a2d\u5b9a \u203a \u96b1\u79c1\u8207\u5b89\u5168 \u203a \u958b\u767c\u8005\u6a21\u5f0f\uff0c\u7136\u5f8c\u91cd\u555f\u624b\u6a5f\u3002"
          }
