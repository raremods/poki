            "value": "\u50b3\u9001\u4efb\u52d9\u6216\u667a\u6167\u9ad4\u8acb\u6c42\u6642\uff0cQeno \u53ef\u5728\u6b64 iPhone \u4e0a\u9ede\u6309\u548c\u8f38\u5165\u3002"
          }
        }
      }
    },
    "Qeno can tap, type, and scroll on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u53ef\u5728\u6b64 iPhone \u4e0a\u70b9\u6309\u3001\u8f93\u5165\u548c\u6ed1\u52a8\u3002"
          }
