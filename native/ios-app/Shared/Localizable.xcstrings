    "Taps and types from Qeno itself, without Qeno Runner. Self test taps the field above and types into it. Later waits, then taps the point (x, y) and types, in whatever app is in front.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Taps and types directly from Qeno without Qeno Runner. Self test taps the field above and types into it; Later waits, then taps (x, y) and types in the frontmost app."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u9700 Qeno Runner\uff0c\u76f4\u63a5\u7531 Qeno \u6267\u884c\u70b9\u51fb\u548c\u8f93\u5165\u3002\u201c\u81ea\u68c0\u201d\u4f1a\u5148\u70b9\u51fb\u4e0a\u65b9\u8f93\u5165\u6846\u518d\u8f93\u5165\uff1b\u201c\u5ef6\u65f6\u6267\u884c\u201d\u4f1a\u5728\u7b49\u5f85\u540e\u5bf9\u524d\u53f0\u5e94\u7528\u7684 (x, y) \u5750\u6807\u6267\u884c\u70b9\u51fb\u4e0e\u8f93\u5165\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u9700 Qeno Runner\uff0c\u76f4\u63a5\u7531 Qeno \u57f7\u884c\u9ede\u64ca\u548c\u8f38\u5165\u3002\u300c\u81ea\u6211\u6aa2\u6e2c\u300d\u6703\u5148\u9ede\u64ca\u4e0a\u65b9\u8f38\u5165\u6846\u518d\u8f38\u5165\uff1b\u300c\u5ef6\u9072\u57f7\u884c\u300d\u6703\u5728\u7b49\u5f85\u5f8c\u5c0d\u524d\u666f\u61c9\u7528\u7a0b\u5f0f\u7684 (x, y) \u5ea7\u6a19\u57f7\u884c\u9ede\u64ca\u8207\u8f38\u5165\u3002"
          }
        }
      }
    },
