          }
        }
      }
    },
    "Run bin/voice-bridge.mjs on your Mac and enter the address it gives. The Mac holds your OpenAI key and gives this phone a key that works for one minute, so the phone never stores it. Audio goes straight from this phone to OpenAI.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 Mac \u4e0a\u8fd0\u884c bin/voice-bridge.mjs \u5e76\u8f93\u5165\u751f\u6210\u7684\u5730\u5740\u3002OpenAI \u5bc6\u94a5\u4fdd\u5b58\u5728 Mac \u672c\u5730\uff0c\u624b\u673a\u4ec5\u83b7\u53d6\u6709\u6548\u671f 1 \u5206\u949f\u7684\u4e34\u65f6\u51ed\u8bc1\uff0c\u4e0d\u4fdd\u5b58\u5bc6\u94a5\uff0c\u97f3\u9891\u5c06\u7531\u624b\u673a\u76f4\u8fde\u53d1\u9001\u81f3 OpenAI\u3002"
          }
        }
      }
    },
