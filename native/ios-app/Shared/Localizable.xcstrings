    "Starts that Live Activity on this iPhone. Lock the phone or go to the Home Screen to see it. The next one replaces it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64 iPhone \u4e0a\u542f\u52a8\u5bf9\u5e94\u5b9e\u65f6\u6d3b\u52a8\u3002\u9501\u5c4f\u6216\u56de\u5230\u4e3b\u5c4f\u5e55\u5373\u53ef\u67e5\u770b\uff0c\u542f\u52a8\u65b0\u9879\u4f1a\u66ff\u6362\u5f53\u524d\u9879\u3002"
