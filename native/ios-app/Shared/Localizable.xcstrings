    "That is not a relay address. Enter the address deploy.sh printed, such as https://poki-relay.you.workers.dev.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u8f93\u5165 deploy.sh \u8f93\u51fa\u7684\u4e2d\u8f6c\u5730\u5740\uff0c\u4f8b\u5982 https://poki-relay.you.workers.dev\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u8f38\u5165 deploy.sh \u8f38\u51fa\u7684\u4e2d\u8f49\u4f4d\u5740\uff0c\u4f8b\u5982 https://poki-relay.you.workers.dev\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the relay URL printed by deploy.sh, such as https://poki-relay.you.workers.dev."
          }
        }
      }
    },
    "That is not a voice bridge address. It looks like http://192.168.1.10:47830/voice/ followed by a long code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u8f93\u5165\u6709\u6548\u7684\u8bed\u97f3\u6865\u63a5\u5730\u5740\uff0c\u683c\u5f0f\u5982 http://192.168.1.10:47830/voice/ \u52a0\u4e00\u4e32\u5b57\u7b26\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u8f38\u5165\u6709\u6548\u7684\u8a9e\u97f3\u6a4b\u63a5\u4f4d\u5740\uff0c\u683c\u5f0f\u5982 http://192.168.1.10:47830/voice/ \u52a0\u4e00\u4e32\u5b57\u5143\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid voice bridge URL, like http://192.168.1.10:47830/voice/ followed by a token."
          }
        }
      }
    },
