          }
        }
      }
    },
    "Qeno closes by itself so agents can see the screen again. Open Qeno again afterwards, from the notification or the Home Screen. It turns on when it opens.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u4f1a\u81ea\u52a8\u5173\u95ed\u4ee5\u6062\u590d\u667a\u80fd\u4f53\u7684\u5c4f\u5e55\u753b\u9762\u3002\u8bf7\u4ece\u901a\u77e5\u6216\u4e3b\u5c4f\u5e55\u91cd\u65b0\u6253\u5f00 Qeno\uff0c\u6253\u5f00\u540e\u4f1a\u81ea\u52a8\u5f00\u542f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u6703\u81ea\u52d5\u95dc\u9589\u4ee5\u6062\u5fa9\u667a\u6167\u9ad4\u7684\u87a2\u5e55\u756b\u9762\u3002\u8acb\u5f9e\u901a\u77e5\u6216\u4e3b\u756b\u9762\u91cd\u65b0\u958b\u555f Qeno\uff0c\u958b\u555f\u5f8c\u6703\u81ea\u52d5\u958b\u555f\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno closes automatically so agents can see the screen again. Reopen Qeno from the notification or Home Screen to turn it back on."
          }
        }
      }
    },
    "Qeno comes back to the front with its reply when a task ends.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4efb\u52a1\u5b8c\u6210\u65f6\uff0cQeno \u4f1a\u56de\u5230\u524d\u53f0\u5e76\u663e\u793a\u56de\u590d\u3002"
