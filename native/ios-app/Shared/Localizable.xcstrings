          }
        }
      }
    },
    "The update is almost in. Qeno will close to finish it. Open Qeno again afterwards.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u65b0\u5373\u5c06\u5b8c\u6210\u3002Qeno \u5c06\u5173\u95ed\u4ee5\u5b8c\u6210\u66f4\u65b0\u3002\u4e4b\u540e\u8bf7\u91cd\u65b0\u6253\u5f00 Qeno\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u65b0\u5373\u5c07\u5b8c\u6210\u3002Qeno \u5c07\u95dc\u9589\u4ee5\u5b8c\u6210\u66f4\u65b0\u3002\u4e4b\u5f8c\u8acb\u91cd\u65b0\u958b\u555f Qeno\u3002"
          }
        }
      }
    },
    "The update is installed. Swipe up on Qeno in the app switcher to close it, then open Qeno again. Features are unavailable until you reopen Qeno.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update is installed. Swipe up on Qeno in the app switcher to close it, then open Qeno again. Features are unavailable until you reopen Qeno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u7248\u5df2\u5b89\u88c5\u3002\u8bf7\u5728\u591a\u4efb\u52a1\u754c\u9762\u5411\u4e0a\u5212\u6389 Qeno\uff0c\u7136\u540e\u91cd\u65b0\u6253\u5f00\u3002\u91cd\u65b0\u6253\u5f00\u524d\uff0c\u529f\u80fd\u6682\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u7248\u5df2\u5b89\u88dd\u3002\u8acb\u5728\u591a\u5de5\u8655\u7406\u756b\u9762\u5411\u4e0a\u6ed1\u6389 Qeno\uff0c\u7136\u5f8c\u91cd\u65b0\u958b\u555f\u3002\u91cd\u65b0\u958b\u555f\u524d\uff0c\u529f\u80fd\u66ab\u4e0d\u53ef\u7528\u3002"
          }
        }
      }
    },
    "The update is installed. Waiting for Qeno to close. Features are unavailable until you reopen Qeno.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The update is installed. Waiting for Qeno to close. Features are unavailable until you reopen Qeno."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u7248\u5df2\u5b89\u88c5\uff0c\u6b63\u5728\u7b49\u5f85 Qeno \u5173\u95ed\u3002\u91cd\u65b0\u6253\u5f00 Qeno \u524d\uff0c\u529f\u80fd\u6682\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u7248\u5df2\u5b89\u88dd\uff0c\u6b63\u5728\u7b49\u5f85 Qeno \u95dc\u9589\u3002\u91cd\u65b0\u958b\u555f Qeno \u524d\uff0c\u529f\u80fd\u66ab\u4e0d\u53ef\u7528\u3002"
          }
        }
      }
    },
