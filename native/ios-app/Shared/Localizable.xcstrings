    "Qeno keeps its latest %@ entries on this iPhone. Entries can\u2019t be deleted by hand.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u5728\u6b64 iPhone \u4e0a\u4fdd\u7559\u6700\u8fd1 %@ \u6761\u8bb0\u5f55\u3002\u8bb0\u5f55\u65e0\u6cd5\u624b\u52a8\u5220\u9664\u3002"
          }
