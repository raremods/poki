          }
        }
      }
    },
    "When Qeno asks you before a sensitive step, and the record of every action any agent ran on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e\u654f\u611f\u6b65\u9aa4\u524d\u7684\u6279\u51c6\u65b9\u5f0f\uff0c\u5e76\u67e5\u770b\u6240\u6709\u667a\u80fd\u4f53\u5728\u6b64 iPhone \u4e0a\u7684\u64cd\u4f5c\u8bb0\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a\u654f\u611f\u6b65\u9a5f\u524d\u7684\u6279\u51c6\u65b9\u5f0f\uff0c\u4e26\u6aa2\u8996\u6240\u6709\u667a\u6167\u9ad4\u5728\u6b64 iPhone \u4e0a\u7684\u64cd\u4f5c\u8a18\u9304\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Configure when Qeno asks before sensitive steps, and view every action any agent ran on this iPhone."
          }
        }
      }
    },
    "When a Task Ends": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
