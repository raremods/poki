          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**iOS 18 \u4e0a\u4ecd\u986f\u793a\u300c\u5c1a\u672a\u958b\u555f\u300d\uff1f**\u90e8\u5206\u57f7\u884c iOS 18.7 \u7684 iPhone \u59cb\u7d42\u7121\u6cd5\u5f9e Shadowrocket \u7372\u5f97\u9019\u689d\u8def\u7531\uff0c\u8acb\u6539\u7528 LocalDevVPN\u3002"
