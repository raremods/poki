    "Qeno Runner did not start. In Settings \u2192 Developer, turn on UI Automation; in Settings \u2192 General \u2192 VPN & Device Management, trust the developer of Qeno Runner.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u201c\u8bbe\u7f6e \u203a \u5f00\u53d1\u8005\u201d\u4e2d\u5f00\u542f UI \u81ea\u52a8\u5316\uff0c\u5e76\u5728\u201c\u8bbe\u7f6e \u203a \u901a\u7528 \u203a VPN \u4e0e\u8bbe\u5907\u7ba1\u7406\u201d\u4e2d\u4fe1\u4efb\u5f00\u53d1\u8005\u3002Qeno Runner \u672a\u80fd\u542f\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u300c\u8a2d\u5b9a \u203a \u958b\u767c\u8005\u300d\u4e2d\u958b\u555f UI \u81ea\u52d5\u5316\uff0c\u4e26\u5728\u300c\u8a2d\u5b9a \u203a \u4e00\u822c \u203a VPN \u8207\u88dd\u7f6e\u7ba1\u7406\u300d\u4e2d\u4fe1\u4efb\u958b\u767c\u8005\u3002Qeno Runner \u672a\u80fd\u555f\u52d5\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on UI Automation in Settings \u203a Developer, and trust Qeno Runner\u2019s developer in Settings \u203a General \u203a VPN & Device Management. Qeno Runner couldn\u2019t start."
          }
        }
      }
    },
    "Qeno Runner is installed and trusted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5b89\u88c5\u5e76\u4fe1\u4efb Qeno Runner"
          }
        },
        "zh-Hant": {
