        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u6167\u9ad4\u5728 %@ \u79d2\u524d\u57f7\u884c\u904e\u64cd\u4f5c\u3002\u6700\u5f8c\u4e00\u6b65\u5b8c\u6210 1 \u5206\u9418\u5f8c\u5373\u53ef\u5b89\u88dd\u3002"
