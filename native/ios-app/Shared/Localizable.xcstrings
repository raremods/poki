    "The voice bridge doesn't know this address. Copy it again from the Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4ece Mac \u91cd\u65b0\u62f7\u8d1d\u8bed\u97f3\u6865\u63a5\u5730\u5740\u3002\u5f53\u524d\u5730\u5740\u65e0\u6cd5\u8bc6\u522b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5f9e Mac \u91cd\u65b0\u8907\u88fd\u8a9e\u97f3\u6a4b\u63a5\u4f4d\u5740\u3002\u76ee\u524d\u4f4d\u5740\u7121\u6cd5\u8b58\u5225\u3002"
          }
