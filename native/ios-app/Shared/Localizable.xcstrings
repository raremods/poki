    "Qeno Runner is still running after Stop. Swipe it away in the app switcher and the banner goes with it.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728 App \u5207\u6362\u5668\u4e2d\u4e0a\u6ed1\u5173\u95ed Qeno Runner \u4ee5\u6d88\u9664\u6a2a\u5e45\u3002\u505c\u6b62\u540e\u5b83\u4ecd\u5728\u8fd0\u884c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728 App \u5207\u63db\u5668\u4e2d\u4e0a\u6ed1\u95dc\u9589 Qeno Runner \u4ee5\u6d88\u9664\u6a6b\u5e45\u3002\u505c\u6b62\u5f8c\u5b83\u4ecd\u5728\u57f7\u884c\u3002"
