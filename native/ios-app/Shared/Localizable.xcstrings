    },
    "iOS doesn\u2019t let Qeno check this one, so turn the switch on once it\u2019s done.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS \u4e0d\u5141\u8bb8 Qeno \u68c0\u67e5\u8fd9\u4e00\u9879\uff0c\u5b8c\u6210\u540e\u8bf7\u6253\u5f00\u6b64\u5f00\u5173\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS \u4e0d\u5141\u8a31 Qeno \u6aa2\u67e5\u9019\u4e00\u9805\uff0c\u5b8c\u6210\u5f8c\u8acb\u958b\u555f\u6b64\u958b\u95dc\u3002"
          }
        }
      }
    },
    "iOS needs a background mode to keep apps running. Qeno uses lowest-accuracy location with Always Allow, which shows no location indicator, and never records your location.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS \u8981\u6c42\u542f\u7528\u540e\u53f0\u6a21\u5f0f\u4ee5\u4fdd\u6301\u8fd0\u884c\u3002Qeno \u91c7\u7528\u201c\u59cb\u7ec8\u5141\u8bb8\u201d\u7684\u6700\u4f4e\u7cbe\u5ea6\u5b9a\u4f4d\uff0c\u4e0d\u663e\u793a\u5b9a\u4f4d\u56fe\u6807\uff0c\u4e5f\u7edd\u4e0d\u8bb0\u5f55\u4f4d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS \u8981\u6c42\u555f\u7528\u80cc\u666f\u6a21\u5f0f\u4ee5\u4fdd\u6301\u57f7\u884c\u3002Qeno \u63a1\u7528\u300c\u6c38\u9060\u5141\u8a31\u300d\u7684\u6700\u4f4e\u7cbe\u5ea6\u5b9a\u4f4d\uff0c\u4e0d\u986f\u793a\u5b9a\u4f4d\u5716\u793a\uff0c\u4e5f\u7d55\u4e0d\u8a18\u9304\u4f4d\u7f6e\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS requires a background mode to keep apps active. Qeno uses lowest-accuracy location with Always Allow, showing no indicator and never recording your location."
          }
        }
      }
    },
    "iOS requires a background mode to keep apps running. Qeno uses lowest-accuracy location and shows the location indicator while active.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS \u8981\u6c42 App \u58f0\u660e\u7279\u5b9a\u7528\u9014\u624d\u80fd\u5728\u540e\u53f0\u6301\u7eed\u8fd0\u884c\u3002Qeno \u4f1a\u4ee5\u6700\u4f4e\u7cbe\u5ea6\u4f7f\u7528\u5b9a\u4f4d\u670d\u52a1\uff0c\u5e76\u5728\u8fd0\u884c\u671f\u95f4\u663e\u793a\u5b9a\u4f4d\u6307\u793a\u5668\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS \u8981\u6c42 App \u5ba3\u544a\u7279\u5b9a\u7528\u9014\u624d\u80fd\u5728\u5f8c\u81fa\u6301\u7e8c\u57f7\u884c\u3002Qeno \u6703\u4ee5\u6700\u4f4e\u7cbe\u5ea6\u4f7f\u7528\u5b9a\u4f4d\u670d\u52d9\uff0c\u4e26\u5728\u57f7\u884c\u671f\u9593\u986f\u793a\u5b9a\u4f4d\u6307\u793a\u5668\u3002"
          }
        }
      }
    },
    "iOS shows the automation banner only while Qeno\u2019s automation session is open. Qeno opens it when an agent asks and closes it when idle.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5728\u81ea\u52a8\u5316\u4f1a\u8bdd\u5f00\u542f\u65f6\u663e\u793a\u7cfb\u7edf\u6a2a\u5e45\u3002\u667a\u80fd\u4f53\u8bf7\u6c42\u65f6\u81ea\u52a8\u5f00\u542f\uff0c\u95f2\u7f6e\u65f6\u5173\u95ed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u5728\u81ea\u52d5\u5316\u5de5\u4f5c\u968e\u6bb5\u958b\u555f\u6642\u986f\u793a\u7cfb\u7d71\u6a6b\u5e45\u3002\u667a\u6167\u9ad4\u8acb\u6c42\u6642\u81ea\u52d5\u958b\u555f\uff0c\u9592\u7f6e\u6642\u95dc\u9589\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows the automation banner only during an active session. Qeno opens it on agent request and closes it when idle."
          }
        }
      }
    },
    "iOS shows the automation banner only while Qeno\u2019s automation session is open. Qeno opens it when an agent asks and closes it when idle. Memory holds the routines and notes every agent shares.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5728\u81ea\u52a8\u5316\u4f1a\u8bdd\u5f00\u542f\u65f6\u663e\u793a\u7cfb\u7edf\u6a2a\u5e45\uff0c\u667a\u80fd\u4f53\u8bf7\u6c42\u65f6\u5f00\u542f\u3001\u95f2\u7f6e\u65f6\u5173\u95ed\u3002\u201c\u8bb0\u5fc6\u201d\u4fdd\u5b58\u6240\u6709\u667a\u80fd\u4f53\u5171\u4eab\u7684\u6d41\u7a0b\u4e0e\u5907\u5fd8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u5728\u81ea\u52d5\u5316\u5de5\u4f5c\u968e\u6bb5\u958b\u555f\u6642\u986f\u793a\u7cfb\u7d71\u6a6b\u5e45\uff0c\u667a\u6167\u9ad4\u8acb\u6c42\u6642\u958b\u555f\u3001\u9592\u7f6e\u6642\u95dc\u9589\u3002\u300c\u8a18\u61b6\u300d\u5132\u5b58\u6240\u6709\u667a\u6167\u9ad4\u5171\u4eab\u7684\u6d41\u7a0b\u8207\u5099\u5fd8\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows the automation banner only during an active session. Qeno opens it on agent request and closes it when idle. Memory stores shared routines and notes."
          }
        }
      }
    },
    "iOS shows the automation banner only while the runner is active. Qeno starts it when needed and stops it when idle. Don\u2019t close Qeno Runner while an agent is working.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5728 Runner \u8fd0\u884c\u65f6\u663e\u793a\u7cfb\u7edf\u6a2a\u5e45\u3002\u6309\u9700\u542f\u52a8\uff0c\u95f2\u7f6e\u505c\u6b62\u3002\u667a\u80fd\u4f53\u5de5\u4f5c\u65f6\u8bf7\u52ff\u5173\u95ed Qeno Runner\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u5728 Runner \u57f7\u884c\u6642\u986f\u793a\u7cfb\u7d71\u6a6b\u5e45\u3002\u6309\u9700\u555f\u52d5\uff0c\u9592\u7f6e\u505c\u6b62\u3002\u667a\u6167\u9ad4\u5de5\u4f5c\u6642\u8acb\u52ff\u95dc\u9589 Qeno Runner\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS shows the automation banner only while Runner is active. Qeno starts it when needed and stops it when idle. Don\u2019t close Qeno Runner while an agent is working."
          }
        }
      }
    },
