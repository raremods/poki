    "With Confirmation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u786e\u8ba4\u6309\u94ae"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
