        }
      }
    },
    "%@ in %@. Open Qeno to allow or deny.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u201c%2$@\u201d\u4e2d%1$@\u3002\u6253\u5f00 Qeno \u5141\u8bb8\u6216\u62d2\u7edd\u3002"
          }
        }
      }
    },
    "%@ key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u5bc6\u94a5"
          }
        }
      }
    },
    "%@ or later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u6216\u66f4\u9ad8\u7248\u672c"
          }
        }
      }
    },
    "%@%@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@%@"
          }
        }
      }
    },
    "%@, %lld missed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@\uff0c%2$lld \u6b65\u5931\u8d25"
          }
        }
      }
    },
    "%@, Step %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uff0c\u7b2c %lld \u6b65"
          }
        }
      }
    },
    "%@, waiting for you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uff0c\u7b49\u5f85\u786e\u8ba4"
          }
        }
      }
    },
    "%@, your %@ key": {
      "localizations": {
        "zh-Hans": {
