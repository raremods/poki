    "the pairing file from a computer does not work over the loopback on this iOS version. Pair this iPhone here once and the pairing stays.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u6b64 iPhone \u4e0a\u76f4\u63a5\u914d\u5bf9\u4e00\u6b21\uff08\u914d\u5bf9\u4f1a\u4fdd\u7559\uff09\u3002\u5f53\u524d iOS \u7248\u672c\u4e0d\u652f\u6301\u901a\u8fc7\u56de\u73af\u4f7f\u7528\u7535\u8111\u914d\u5bf9\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u6b64 iPhone \u4e0a\u76f4\u63a5\u914d\u5c0d\u4e00\u6b21\uff08\u914d\u5c0d\u6703\u4fdd\u7559\uff09\u3002\u76ee\u524d iOS \u7248\u672c\u4e0d\u652f\u63f4\u900f\u904e\u8ff4\u74b0\u4f7f\u7528\u96fb\u8166\u914d\u5c0d\u6a94\u6848\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair directly on this iPhone once (the pairing stays). Computer pairing files don\u2019t work over Loopback on this iOS version."
          }
        }
      }
    },
