            "value": "\u5747\u8861"
          }
        }
      }
    },
    "Balanced. Your chat model approves a step in Qeno\u2019s own chat when it directly serves what you asked for. You are asked about the rest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5747\u8861\u3002\u5728 Qeno \u81ea\u5df1\u7684\u804a\u5929\u4e2d\uff0c\u67d0\u4e00\u6b65\u76f4\u63a5\u670d\u52a1\u4e8e\u4f60\u7684\u8981\u6c42\u65f6\uff0c\u804a\u5929\u6a21\u578b\u4f1a\u6279\u51c6\u3002\u5176\u4f59\u7684\u4f1a\u8be2\u95ee\u4f60\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5747\u8861\u3002\u5728 Qeno \u81ea\u5df1\u7684\u804a\u5929\u4e2d\uff0c\u67d0\u4e00\u6b65\u76f4\u63a5\u670d\u52d9\u65bc\u4f60\u7684\u8981\u6c42\u6642\uff0c\u804a\u5929\u6a21\u578b\u6703\u6279\u51c6\u3002\u5176\u9918\u7684\u6703\u8a62\u554f\u4f60\u3002"
          }
        }
      }
    },
    "Behavior": {
      "localizations": {
