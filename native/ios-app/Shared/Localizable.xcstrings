          }
        }
      }
    },
    "Qeno can tap and type on this iPhone when you send a task or an agent requests it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53d1\u9001\u4efb\u52a1\u6216\u667a\u80fd\u4f53\u8bf7\u6c42\u65f6\uff0cQeno \u53ef\u5728\u6b64 iPhone \u4e0a\u70b9\u6309\u548c\u8f93\u5165\u3002"
          }
        },
        "zh-Hant": {
