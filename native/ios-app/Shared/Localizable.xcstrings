          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u672a\u80fd\u958b\u555f\u81ea\u8eab\u7684\u81ea\u52d5\u5316\u6703\u8a71\uff08%@\uff09\uff0c\u8ff4\u74b0\u4e5f\u62d2\u7d55\u4e86\u9023\u7dda\u3002\u5728\u914d\u7f6e\u4e2d\u6aa2\u67e5\u8ff4\u74b0\uff0c\u7136\u5f8c\u518d\u8a66\u3002"
          }
        }
      }
    },
