          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u7a0d\u540e\u91cd\u8bd5\u3002\u7b7e\u540d\u670d\u52a1\u672a\u63a5\u53d7\u8bf7\u6c42\u3002"
