    "No extra app needed. Qeno connects only to this iPhone; your normal internet traffic and DNS stay on their usual routes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u9700\u989d\u5916 App\u3002Qeno \u53ea\u8fde\u63a5\u6b64 iPhone\uff0c\u4f60\u5e73\u5e38\u7684\u7f51\u7edc\u6d41\u91cf\u548c DNS \u4ecd\u8d70\u539f\u6765\u7684\u8def\u7ebf\u3002"
          }
        }
      }
    },
    "No interface has a 10.7.0.x address. Check that your proxy app is on and its loopback module is enabled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u63a5\u53e3\u62e5\u6709 10.7.0.x \u5730\u5740\u3002\u8bf7\u68c0\u67e5\u4ee3\u7406 App \u662f\u5426\u5f00\u542f\uff0c\u4ee5\u53ca\u56de\u73af\u6a21\u5757\u662f\u5426\u542f\u7528\u3002"
          }
        }
      }
    },
    "No proxy app? Install LocalDevVPN, a free loopback app built for this.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u4ee3\u7406 App\uff1f\u8bf7\u5b89\u88c5\u4e13\u4e3a\u6b64\u8bbe\u8ba1\u7684\u514d\u8d39\u56de\u73af App LocalDevVPN\u3002"
          }
        }
