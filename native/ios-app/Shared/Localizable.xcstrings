    "Payments, deletions and actions in Wallet always need your confirmation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed8\u6b3e\u3001\u5220\u9664\u53ca\u201c\u94b1\u5305\u201d\u64cd\u4f5c\u59cb\u7ec8\u9700\u8981\u4f60\u786e\u8ba4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed8\u6b3e\u3001\u522a\u9664\u53ca\u300c\u9322\u5305\u300d\u64cd\u4f5c\u59cb\u7d42\u9700\u8981\u4f60\u78ba\u8a8d\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payments, deletions, and Wallet actions always require your confirmation."
          }
        }
      }
    },
    "Payments, deletions, and Wallet actions always require your confirmation; other sensitive steps go ahead without asking.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed8\u6b3e\u3001\u5220\u9664\u53ca\u201c\u94b1\u5305\u201d\u64cd\u4f5c\u59cb\u7ec8\u9700\u8981\u4f60\u786e\u8ba4\uff0c\u5176\u4ed6\u654f\u611f\u6b65\u9aa4\u76f4\u63a5\u8fdb\u884c\u3002"
          }
        },
        "en": {
          "stringUnit": {
