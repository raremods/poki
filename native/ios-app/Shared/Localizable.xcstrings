            "value": "\u6d4f\u89c8\u5668"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u700f\u89bd\u5668"
          }
        }
      }
    },
    "Qeno\u2019s signing ends soon": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u7684\u7b7e\u540d\u5feb\u5230\u671f\u4e86"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Qeno \u7684\u7c3d\u540d\u5feb\u5230\u671f\u4e86"
          }
        }
      }
    },
    "Qeno\u2019s usual way of controlling this iPhone keeps failing. Start anyway with iOS\u2019s automation banner showing, or wait.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u5141\u8bb8\u663e\u793a iOS \u81ea\u52a8\u5316\u6a2a\u5e45\u76f4\u63a5\u542f\u52a8\uff0c\u6216\u7ee7\u7eed\u7b49\u5f85\u3002\u5e38\u89c4\u63a7\u5236\u65b9\u5f0f\u6301\u7eed\u5931\u8d25\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u5141\u8a31\u986f\u793a iOS \u81ea\u52d5\u5316\u6a6b\u5e45\u76f4\u63a5\u555f\u52d5\uff0c\u6216\u7e7c\u7e8c\u7b49\u5f85\u3002\u5e38\u898f\u63a7\u5236\u65b9\u5f0f\u6301\u7e8c\u5931\u6557\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start with the iOS automation banner visible, or keep waiting. Standard control keeps failing."
          }
        }
      }
    },
    "RELAY ADDRESS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e2d\u8f6c\u5730\u5740"
          }
        },
