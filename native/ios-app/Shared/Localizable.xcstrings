    "%@ didn\u2019t return its model list. The built-in models still work.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u672a\u8fd4\u56de\u6a21\u578b\u5217\u8868\u3002\u5185\u7f6e\u6a21\u578b\u4ecd\u53ef\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u672a\u8fd4\u56de\u6a21\u578b\u5217\u8868\u3002\u5167\u5efa\u6a21\u578b\u4ecd\u53ef\u4f7f\u7528\u3002"
          }
        }
      }
    },
    "%@ ended the answer with an error and gave no reason. This is usually brief on their side. Tap Try Again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u8f7b\u70b9\u201c\u91cd\u8bd5\u201d\u3002%@ \u610f\u5916\u4e2d\u65ad\u4e86\u56de\u590d\uff0c\u901a\u5e38\u662f\u4e34\u65f6\u95ee\u9898\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u8f15\u9ede\u300c\u91cd\u8a66\u300d\u3002%@ \u610f\u5916\u4e2d\u65b7\u4e86\u56de\u8986\uff0c\u901a\u5e38\u662f\u81e8\u6642\u554f\u984c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Try Again. %@ ended the response with an unexpected error, which is usually temporary."
          }
        }
      }
    },
