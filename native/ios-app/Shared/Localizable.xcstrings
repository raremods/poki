        }
      }
    },
    "1 link": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u4e2a\u94fe\u63a5"
          }
        }
      }
    },
    "1 minute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u5206\u949f"
          }
        }
      }
    },
    "1 step": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u6b65"
          }
        }
      }
    },
    "10.7.0.1 takes the connection, but the phone's remote pairing service does not answer through it, so this page can show Working while Qeno cannot connect. Reconnect your proxy app or LocalDevVPN, then pair again in Setup \u203a Pairing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "10.7.0.1 \u63a5\u53d7\u4e86\u8fde\u63a5\uff0c\u4f46\u624b\u673a\u7684\u8fdc\u7a0b\u914d\u5bf9\u670d\u52a1\u6ca1\u6709\u901a\u8fc7\u5b83\u56de\u5e94\uff0c\u6240\u4ee5\u672c\u9875\u53ef\u80fd\u663e\u793a\u201c\u6b63\u5e38\u201d\u800c Qeno \u4ecd\u8fde\u4e0d\u4e0a\u3002\u8bf7\u91cd\u65b0\u8fde\u63a5\u4ee3\u7406 App \u6216 LocalDevVPN\uff0c\u7136\u540e\u5230\u201c\u8bbe\u7f6e\u5f15\u5bfc \u203a \u914d\u5bf9\u201d\u91cd\u65b0\u914d\u5bf9\u3002"
          }
        }
      }
    },
    "2 minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2 \u5206\u949f"
          }
        }
      }
    },
    "30 seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "30 \u79d2"
          }
        }
      }
    },
    "5 minutes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 \u5206\u949f"
          }
        }
      }
    },
    "A key is saved. Enter a new one to replace it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4fdd\u5b58\u5bc6\u94a5\u3002\u8f93\u5165\u65b0\u5bc6\u94a5\u5c06\u8986\u76d6\u539f\u5bc6\u94a5\u3002"
          }
        }
      }
    },
    "ADDRESSES": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f51\u7edc\u5730\u5740"
          }
        }
      }
    },
    "AGENTS": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53"
          }
        }
      }
    },
    "API key, if it needs one": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API \u5bc6\u94a5\uff08\u53ef\u9009\uff09"
          }
        }
      }
    },
    "About 5 minutes. Everything stays on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ea6\u9700 5 \u5206\u949f\u3002\u6240\u6709\u6570\u636e\u5747\u4fdd\u7559\u5728\u6b64 iPhone \u4e0a\u3002"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0"
          }
        }
      }
    },
    "Add Key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0\u5bc6\u94a5"
          }
        }
      }
    },
    "Add URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0\u5730\u5740"
          }
        }
      }
    },
    "Add a model key first: tap my picture, then Model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u6dfb\u52a0\u6a21\u578b\u5bc6\u94a5\uff1a\u8f7b\u70b9\u5934\u50cf\uff0c\u518d\u9009\u62e9\u201c\u6a21\u578b\u201d\u3002"
          }
        }
      }
    },
    "Add it to the tun inbound in your sing-box profile, then reload the profile.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u5176\u6dfb\u52a0\u5230 sing-box \u914d\u7f6e\u7684 tun \u5165\u7ad9\u4e2d\uff0c\u7136\u540e\u91cd\u65b0\u52a0\u8f7d\u914d\u7f6e\u3002"
          }
        }
      }
    },
    "Add the Qeno Keyboard": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0 Qeno \u952e\u76d8"
          }
        }
      }
    },
    "Add this URL as a remote MCP server in your client. Anyone with this link can control this iPhone while Qeno is running. Keep it private, and revoke it here if compromised.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5ba2\u6237\u7aef\u4e2d\u5c06\u6b64\u5730\u5740\u6dfb\u52a0\u4e3a\u8fdc\u7a0b MCP \u670d\u52a1\u5668\u3002Qeno \u8fd0\u884c\u671f\u95f4\uff0c\u4efb\u4f55\u6301\u6709\u6b64\u5730\u5740\u7684\u4eba\u90fd\u80fd\u63a7\u5236\u6b64 iPhone\u3002\u8bf7\u59a5\u5584\u4fdd\u7ba1\uff0c\u5982\u6709\u6cc4\u9732\u8bf7\u5728\u6b64\u5904\u64a4\u9500\u3002"
          }
        }
      }
    },
    "Add your %@ key: tap my picture, then Model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u6dfb\u52a0 %@ \u5bc6\u94a5\uff1a\u8f7b\u70b9\u5934\u50cf\uff0c\u518d\u9009\u62e9\u201c\u6a21\u578b\u201d\u3002"
          }
        }
      }
    },
    "Add your agent": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0\u667a\u80fd\u4f53"
          }
        }
      }
    },
    "Add your key to chat with Qeno": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0\u5bc6\u94a5\u4ee5\u5f00\u59cb\u4e0e Qeno \u5bf9\u8bdd"
          }
        }
      }
    },
    "Added": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u52a0\u65e5\u671f"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u670d\u52a1\u5730\u5740"
          }
        }
      }
    },
    "After restarting, unlock this iPhone and tap **Turn On**.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u542f\u52a8\u540e\uff0c\u89e3\u9501\u6b64 iPhone \u5e76\u8f7b\u70b9\u201c**\u6253\u5f00**\u201d\u3002"
          }
        }
      }
    },
    "Agent finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u5df2\u5b8c\u6210"
          }
        }
      }
    },
    "Agents can reach this iPhone, but Qeno can\u2019t tap until Loopback is on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u5df2\u53ef\u8fde\u63a5\u6b64 iPhone\uff0c\u4f46\u5f00\u542f\u56de\u73af\u540e Qeno \u624d\u80fd\u6267\u884c\u8f7b\u70b9\u3002"
          }
        }
      }
    },
    "Agents can\u2019t reach this iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u65e0\u6cd5\u8fde\u63a5\u6b64 iPhone"
          }
        }
      }
    },
    "All Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u8bbe\u7f6e"
          }
        }
      }
    },
    "All Steps": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u6b65\u9aa4"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8"
          }
        }
      }
    },
    "Allow Location Access": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u8bbf\u95ee\u4f4d\u7f6e\u4fe1\u606f"
          }
        }
      }
    },
    "Allow UI Automation": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8 UI \u81ea\u52a8\u5316"
          }
        }
      }
    },
    "Allow action": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u64cd\u4f5c"
          }
        }
      }
    },
    "Allow location access for Qeno (Settings \u203a Qeno \u203a Location \u203a Always). Qeno uses it only to keep running; it never records where you are.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5141\u8bb8 Qeno \u8bbf\u95ee\u4f4d\u7f6e\u4fe1\u606f\uff08\u8bbe\u7f6e \u203a Qeno \u203a \u4f4d\u7f6e \u203a \u59cb\u7ec8\uff09\u3002Qeno \u4ec5\u7528\u5b83\u4fdd\u6301\u8fd0\u884c\uff0c\u7edd\u4e0d\u8bb0\u5f55\u4f60\u7684\u4f4d\u7f6e\u3002"
          }
        }
      }
    },
    "Allow this step?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u8fd9\u4e00\u6b65\u5417\uff1f"
          }
        }
      }
    },
    "Allowed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5141\u8bb8"
          }
        }
      }
    },
    "Allows Qeno Runner to control other apps.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8 Qeno Runner \u64cd\u4f5c\u5176\u4ed6 App\u3002"
          }
        }
      }
    },
    "Allows Qeno to reach this iPhone\u2019s developer services through your proxy app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8 Qeno \u901a\u8fc7\u4f60\u5e38\u7528\u7684\u4ee3\u7406 App \u8fde\u63a5\u6b64 iPhone \u7684\u5f00\u53d1\u8005\u670d\u52a1\u3002"
          }
        }
      }
    },
    "Allows Qeno to reach this iPhone\u2019s developer services, with its built-in connection or your proxy app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8 Qeno \u901a\u8fc7\u5185\u7f6e\u8fde\u63a5\u6216\u4f60\u5e38\u7528\u7684\u4ee3\u7406 App \u8fde\u63a5\u6b64 iPhone \u7684\u5f00\u53d1\u8005\u670d\u52a1\u3002"
          }
        }
      }
    },
    "Allows this iPhone to run Qeno Runner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5141\u8bb8\u6b64 iPhone \u8fd0\u884c Qeno Runner\u3002"
          }
        }
      }
    },
    "Almost Ready": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5373\u5c06\u5c31\u7eea"
          }
        }
      }
    },
    "Anthropic answered %lld: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic \u8fd4\u56de\u9519\u8bef\uff08%lld\uff09\uff1a%@"
          }
        }
      }
    },
    "Anthropic did not accept the key. Check it in Qeno \u203a Model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic \u5bc6\u94a5\u65e0\u6548\u3002\u8bf7\u524d\u5f80\u201cQeno\u201d\u203a\u201c\u6a21\u578b\u201d\u68c0\u67e5\u3002"
          }
        }
      }
    },
    "Anthropic is overloaded right now. Try again in a minute.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic \u670d\u52a1\u7e41\u5fd9\uff0c\u8bf7\u7a0d\u540e\u518d\u8bd5\u3002"
          }
        }
      }
    },
    "Anthropic says the key has hit its rate limit. Try again in a minute.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8fbe\u8c03\u7528\u9891\u7387\u4e0a\u9650\uff0c\u8bf7\u7a0d\u540e\u518d\u8bd5\u3002"
          }
        }
      }
    },
    "Any OpenAI-compatible URL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u517c\u5bb9 OpenAI \u7684\u63a5\u53e3\u5730\u5740"
          }
        }
      }
    },
    "Apple Account": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple \u8d26\u53f7"
          }
        }
      }
    },
    "Approval": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6279\u51c6"
          }
        }
      }
    },
    "Approval Required": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9700\u8981\u6279\u51c6"
          }
        }
      }
    },
    "Approvals": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6279\u51c6"
          }
        }
      }
    },
    "Approved in the Dynamic Island, %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5728\u7075\u52a8\u5c9b\u6279\u51c6\uff1a%@"
          }
        }
      }
    },
    "Approved, %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
