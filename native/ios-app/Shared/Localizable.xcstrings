    "One file with every routine and note. Importing merges it in, and the newer copy of a routine wins. Qeno Setup on your computer can back it up and put it back.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u6240\u6709\u6d41\u7a0b\u548c\u5907\u5fd8\u5bfc\u51fa\u4e3a\u5355\u4e2a\u6587\u4ef6\u3002\u5bfc\u5165\u65f6\u81ea\u52a8\u5408\u5e76\u5e76\u4fdd\u7559\u8f83\u65b0\u7248\u672c\uff0c\u4e5f\u53ef\u7528\u7535\u8111\u4e0a\u7684 Qeno Setup \u5907\u4efd\u4e0e\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u6240\u6709\u6d41\u7a0b\u548c\u5099\u5fd8\u532f\u51fa\u70ba\u55ae\u4e00\u6a94\u6848\u3002\u532f\u5165\u6642\u81ea\u52d5\u5408\u4f75\u4e26\u4fdd\u7559\u8f03\u65b0\u7248\u672c\uff0c\u4e5f\u53ef\u7528\u96fb\u8166\u4e0a\u7684 Qeno Setup \u5099\u4efd\u8207\u9084\u539f\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exports one file with all routines and notes. Importing merges entries, keeping newer versions. Qeno Setup on your computer can also back up and restore it."
          }
        }
      }
    },
