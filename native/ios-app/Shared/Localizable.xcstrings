    "Runner starts and stops, agent steps, approvals, and connection changes. Password field entries are never logged.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bb0\u5f55 Runner \u542f\u505c\u3001\u667a\u80fd\u4f53\u6b65\u9aa4\u3001\u6279\u51c6\u53ca\u8fde\u63a5\u53d8\u5316\u3002\u5bc6\u7801\u8f93\u5165\u6846\u4e2d\u7684\u5185\u5bb9\u7edd\u4e0d\u8bb0\u5165\u65e5\u5fd7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a18\u9304 Runner \u555f\u505c\u3001\u667a\u6167\u9ad4\u6b65\u9a5f\u3001\u6279\u51c6\u53ca\u9023\u7dda\u8b8a\u5316\u3002\u5bc6\u78bc\u8f38\u5165\u6846\u4e2d\u7684\u5167\u5bb9\u7d55\u4e0d\u8a18\u5165\u65e5\u8a8c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runner starts and stops, agent steps, approvals, and connection changes. Password field entries are never logged."
          }
        }
      }
