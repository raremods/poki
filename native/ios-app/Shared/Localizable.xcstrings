    "Open a new issue. Say what you did, what you expected and what happened, and attach the log.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u5efa\u4e00\u4e2a issue\u3002\u8bf4\u660e\u4f60\u505a\u4e86\u4ec0\u4e48\u3001\u9884\u671f\u7684\u7ed3\u679c\u548c\u5b9e\u9645\u53d1\u751f\u7684\u60c5\u51b5\uff0c\u5e76\u9644\u4e0a\u65e5\u5fd7\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u589e\u4e00\u500b issue\u3002\u8aaa\u660e\u4f60\u505a\u4e86\u4ec0\u9ebc\u3001\u9810\u671f\u7684\u7d50\u679c\u548c\u5be6\u969b\u767c\u751f\u7684\u60c5\u6cc1\uff0c\u4e26\u9644\u4e0a\u65e5\u8a8c\u3002"
          }
        }
      }
    },
    "Open an account to choose what it is used for. Dictation in the message field needs no account.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u9009\u8d26\u6237\u4ee5\u8bbe\u7f6e\u7528\u9014\u3002\u8f93\u5165\u6846\u542c\u5199\u65e0\u9700\u8d26\u6237\u3002"
