            "value": "\u8acb\u5728\u300c\u8a2d\u5b9a \u203a Qeno \u203a \u5373\u6642\u52d5\u614b\u300d\u4e2d\u958b\u555f\u5373\u6642\u52d5\u614b\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
