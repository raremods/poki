    "Settings > Privacy & Security > Developer Mode > Pair with Qeno, then type the code shown here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings \u203a Privacy & Security \u203a Developer Mode \u203a Pair with Qeno, then enter the code shown here."
