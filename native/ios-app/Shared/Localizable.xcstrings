    "Memory holds the routines and notes every agent shares.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u8bb0\u5fc6\u201d\u4fdd\u5b58\u6240\u6709\u667a\u80fd\u4f53\u5171\u4eab\u7684\u6d41\u7a0b\u4e0e\u5907\u5fd8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u8a18\u61b6\u300d\u5132\u5b58\u6240\u6709\u667a\u6167\u9ad4\u5171\u4eab\u7684\u6d41\u7a0b\u8207\u5099\u5fd8\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory stores routines and notes shared across agents."
          }
        }
      }
    },
    "Memory holds the routines and notes every agent shares. Approvals asks you before an agent pays, deletes, sends a message, places a call, types a password or does anything in Wallet.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c\u8bb0\u5fc6\u201d\u4fdd\u5b58\u6240\u6709\u667a\u80fd\u4f53\u5171\u4eab\u7684\u6d41\u7a0b\u4e0e\u5907\u5fd8\u3002\u201c\u6279\u51c6\u201d\u4f1a\u5728\u667a\u80fd\u4f53\u4ed8\u6b3e\u3001\u5220\u9664\u3001\u53d1\u6d88\u606f\u3001\u6253\u7535\u8bdd\u3001\u8f93\u5bc6\u7801\u6216\u64cd\u4f5c\u201c\u94b1\u5305\u201d\u524d\u5148\u5411\u4f60\u786e\u8ba4\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory stores shared routines and notes. Approvals asks before an agent pays, deletes, sends messages, places calls, enters passwords, or uses Wallet."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u8a18\u61b6\u300d\u5132\u5b58\u6240\u6709\u667a\u6167\u9ad4\u5171\u4eab\u7684\u6d41\u7a0b\u8207\u5099\u5fd8\u3002\u300c\u6279\u51c6\u300d\u6703\u5728\u667a\u6167\u9ad4\u4ed8\u6b3e\u3001\u522a\u9664\u3001\u50b3\u8a0a\u606f\u3001\u6253\u96fb\u8a71\u3001\u8f38\u5bc6\u78bc\u6216\u64cd\u4f5c\u300c\u9322\u5305\u300d\u524d\u5148\u5411\u4f60\u78ba\u8a8d\u3002"
          }
        }
      }
    },
