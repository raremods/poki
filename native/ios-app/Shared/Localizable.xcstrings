    "Stop talking ends Qeno's reply; a step already running on the phone still finishes and Qeno tells you how it went.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u65ad\u64ad\u62a5\u4ec5\u505c\u6b62\u8bed\u97f3\u56de\u590d\uff0c\u5f53\u524d\u6b63\u5728\u6267\u884c\u7684\u64cd\u4f5c\u4ecd\u4f1a\u5b8c\u6210\u5e76\u5411\u4f60\u53cd\u9988\u7ed3\u679c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u65b7\u64ad\u5831\u50c5\u505c\u6b62\u8a9e\u97f3\u56de\u8986\uff0c\u7576\u524d\u6b63\u5728\u57f7\u884c\u7684\u64cd\u4f5c\u4ecd\u6703\u5b8c\u6210\u4e26\u5411\u4f60\u53cd\u994b\u7d50\u679c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop talking ends Qeno's reply. A step already running on the phone still finishes and Qeno tells you how it went."
