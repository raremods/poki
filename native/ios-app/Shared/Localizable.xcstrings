    "I think with a model from your own account. Sign in or add a key. You can change it any time.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I think with a model from your own account. Sign in or add a key. You can change it any time."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7528\u4f60\u81ea\u5df1\u8d26\u6237\u91cc\u7684\u6a21\u578b\u601d\u8003\u3002\u767b\u5f55\u6216\u6dfb\u52a0\u5bc6\u94a5\uff0c\u4e4b\u540e\u968f\u65f6\u53ef\u4ee5\u6362\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u7528\u4f60\u81ea\u5df1\u5e33\u865f\u88e1\u7684\u6a21\u578b\u601d\u8003\u3002\u767b\u5165\u6216\u65b0\u589e\u91d1\u9470\uff0c\u4e4b\u5f8c\u96a8\u6642\u53ef\u4ee5\u63db\u3002"
          }
        }
      }
    },
    "I tripped. I lost my grip on your phone at step 2, so I stopped before touching anything else.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505a\u5230\u7b2c 2 \u6b65\u65f6\u8ddf\u624b\u673a\u65ad\u5f00\u4e86\uff0c\u6211\u6ca1\u518d\u78b0\u522b\u7684\uff0c\u5148\u505c\u4e0b\u4e86\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lost connection to your phone at step 2, so I stopped right there."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505a\u5230\u7b2c 2 \u6b65\u6642\u8ddf\u624b\u6a5f\u65b7\u958b\u4e86\uff0c\u6211\u6c92\u518d\u78b0\u5225\u7684\uff0c\u5148\u505c\u4e0b\u4e86\u3002"
          }
        }
      }
    },
