    "Another VPN appears to be on, so Qeno did not turn its local connection back on. Turn that VPN off and tap Enable Local Connection, or choose an external connection in Setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5173\u95ed\u5176\u4ed6 VPN \u518d\u8f7b\u70b9\u201c\u5f00\u542f\u672c\u673a\u8fde\u63a5\u201d\uff0c\u6216\u5728\u201c\u914d\u7f6e\u201d\u4e2d\u6539\u7528\u5916\u90e8\u8fde\u63a5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u95dc\u9589\u5176\u4ed6 VPN \u518d\u8f15\u9ede\u300c\u958b\u555f\u672c\u6a5f\u9023\u7dda\u300d\uff0c\u6216\u5728\u300c\u8a2d\u5b9a\u7cbe\u9748\u300d\u4e2d\u6539\u7528\u5916\u90e8\u9023\u7dda\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off the other active VPN and tap Enable Local Connection, or choose an external connection in Setup."
          }
        }
      }
    },
