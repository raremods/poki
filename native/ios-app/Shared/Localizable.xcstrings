    "Check that Developer Mode is on (Settings \u2192 Privacy & Security \u2192 Developer Mode) and that iOS is 17.4 or later.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u201c\u8bbe\u7f6e \u203a \u9690\u79c1\u4e0e\u5b89\u5168 \u203a \u5f00\u53d1\u8005\u6a21\u5f0f\u201d\u4e2d\u5f00\u542f\u5f00\u53d1\u8005\u6a21\u5f0f\uff0c\u5e76\u786e\u8ba4\u7cfb\u7edf\u4e3a iOS 17.4 \u6216\u66f4\u9ad8\u7248\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u300c\u8a2d\u5b9a \u203a \u96b1\u79c1\u6b0a\u8207\u5b89\u5168\u6027 \u203a \u958b\u767c\u8005\u6a21\u5f0f\u300d\u4e2d\u958b\u555f\u958b\u767c\u8005\u6a21\u5f0f\uff0c\u4e26\u78ba\u8a8d\u7cfb\u7d71\u70ba iOS 17.4 \u6216\u4ee5\u4e0a\u7248\u672c\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Developer Mode in Settings \u203a Privacy & Security \u203a Developer Mode, and make sure iOS is 17.4 or later."
          }
        }
      }
    },
