        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u524d\u5f80\u201c\u8bbe\u7f6e \u203a \u9690\u79c1\u4e0e\u5b89\u5168 \u203a \u5f00\u53d1\u8005\u6a21\u5f0f \u203a \u4e0e Qeno \u914d\u5bf9\u201d\uff0c\u8f93\u5165\u6b64\u5904\u663e\u793a\u7684\u914d\u5bf9\u7801\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u524d\u5f80\u300c\u8a2d\u5b9a \u203a \u96b1\u79c1\u6b0a\u8207\u5b89\u5168\u6027 \u203a \u958b\u767c\u8005\u6a21\u5f0f \u203a \u8207 Qeno \u914d\u5c0d\u300d\uff0c\u8f38\u5165\u6b64\u8655\u986f\u793a\u7684\u914d\u5c0d\u78bc\u3002"
          }
        }
      }
    },
