    "Could not start Qeno's local VPN. Allow the VPN configuration when asked. If signing does not include Network Extensions, use the external-connection build with LocalDevVPN or a compatible proxy.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u5f39\u7a97\u4e2d\u5141\u8bb8 VPN \u914d\u7f6e\uff1b\u82e5\u7b7e\u540d\u4e0d\u542b\u7f51\u7edc\u6269\u5c55\uff0c\u8bf7\u6539\u7528\u5916\u90e8\u8fde\u63a5\u7248\u642d\u914d LocalDevVPN \u6216\u4ee3\u7406\u3002\u65e0\u6cd5\u542f\u52a8\u672c\u673a VPN\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u5f48\u7a97\u4e2d\u5141\u8a31 VPN \u8a2d\u5b9a\uff1b\u82e5\u7c3d\u540d\u4e0d\u542b\u7db2\u8def\u5ef6\u4f38\u529f\u80fd\uff0c\u8acb\u6539\u7528\u5916\u90e8\u9023\u7dda\u7248\u642d\u914d LocalDevVPN \u6216\u4ee3\u7406\u3002\u7121\u6cd5\u555f\u52d5\u672c\u6a5f VPN\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the VPN configuration if prompted, or use the external-connection build with LocalDevVPN or a proxy if signing lacks Network Extensions. Couldn\u2019t start Qeno\u2019s local VPN."
          }
        }
      }
    },
