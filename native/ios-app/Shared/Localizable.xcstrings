    "Qeno couldn\u2019t read its relay key from the keychain (%lld).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u91cd\u5f00 Qeno \u6216\u7528\u7b7e\u540d\u5de5\u5177\u91cd\u88c5\u3002\u65e0\u6cd5\u4ece\u94a5\u5319\u4e32\u8bfb\u53d6\u4e2d\u8f6c\u5bc6\u94a5\uff08%lld\uff09\u3002"
