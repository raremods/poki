        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u201c\u8bbe\u7f6e \u203a Qeno \u203a \u5b9e\u65f6\u6d3b\u52a8\u201d\u4e2d\u5f00\u542f\u5b9e\u65f6\u6d3b\u52a8\u3002"
          }
        },
        "zh-Hant": {
