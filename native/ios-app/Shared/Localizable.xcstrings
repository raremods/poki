          }
        }
      }
    },
    "Background App Refresh is restricted on this iPhone (Low Power Mode, Screen Time or a profile turns it off), so iOS may stop Qeno in the background.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5173\u95ed\u4f4e\u7535\u91cf\u6a21\u5f0f\uff0c\u6216\u68c0\u67e5\u5c4f\u5e55\u4f7f\u7528\u65f6\u95f4\u4e0e\u63cf\u8ff0\u6587\u4ef6\u9650\u5236\u3002\u201c\u540e\u53f0 App \u5237\u65b0\u201d\u53d7\u9650\u65f6\uff0ciOS \u53ef\u80fd\u4f1a\u5728\u540e\u53f0\u6302\u8d77 Qeno\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u95dc\u9589\u4f4e\u8017\u96fb\u6a21\u5f0f\uff0c\u6216\u6aa2\u67e5\u87a2\u5e55\u4f7f\u7528\u6642\u9593\u8207\u63cf\u8ff0\u6a94\u9650\u5236\u3002\u300c\u80cc\u666f App \u91cd\u65b0\u6574\u7406\u300d\u53d7\u9650\u6642\uff0ciOS \u53ef\u80fd\u6703\u5728\u80cc\u666f\u66ab\u505c Qeno\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off Low Power Mode or check Screen Time and profiles. Background App Refresh is restricted, so iOS may suspend Qeno."
          }
        }
      }
    },
