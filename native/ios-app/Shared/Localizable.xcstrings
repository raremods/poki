    "A live conversation uses OpenAI\u2019s Realtime voice, which needs an OpenAI API key in Settings \u203a Models. Dictation in the message field works with every model.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9e\u65f6\u8bed\u97f3\u4f7f\u7528 OpenAI Realtime\uff0c\u9700\u5728\u201c\u8bbe\u7f6e \u203a \u6a21\u578b\u201d\u4e2d\u6dfb\u52a0 OpenAI API \u5bc6\u94a5\u3002\u8f93\u5165\u6846\u542c\u5199\u652f\u6301\u6240\u6709\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5373\u6642\u8a9e\u97f3\u4f7f\u7528 OpenAI Realtime\uff0c\u9700\u5728\u300c\u8a2d\u5b9a \u203a \u6a21\u578b\u300d\u4e2d\u65b0\u589e OpenAI API \u91d1\u9470\u3002\u8f38\u5165\u6846\u807d\u5beb\u652f\u63f4\u6240\u6709\u6a21\u578b\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Voice uses OpenAI Realtime and requires an OpenAI API key in Settings \u203a Models. Message dictation works with any model."
          }
        }
      }
    },
    "A local connection change is already in progress. Try again when it finishes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a\u8fde\u63a5\u6b63\u5728\u5207\u6362\uff0c\u8bf7\u7a0d\u5019\u518d\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u6a5f\u9023\u7dda\u6b63\u5728\u5207\u63db\uff0c\u8acb\u7a0d\u5019\u518d\u8a66\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wait for the current connection change to finish, then try again."
          }
        }
      }
    },
    "A refreshed Qeno is ready. Open Setup and tap Install before %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728 %@ \u524d\u6253\u5f00\u201c\u914d\u7f6e\u201d\u5e76\u8f7b\u70b9\u201c\u5b89\u88c5\u201d\u3002\u7eed\u7b7e\u7248\u672c\u5df2\u5c31\u7eea\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728 %@ \u524d\u958b\u555f\u300c\u8a2d\u5b9a\u7cbe\u9748\u300d\u4e26\u8f15\u9ede\u300c\u5b89\u88dd\u300d\u3002\u7e8c\u7c3d\u7248\u672c\u5df2\u5c31\u7dd2\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Setup and tap Install before %@. A renewed Qeno build is ready."
          }
        }
