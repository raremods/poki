          "stringUnit": {
            "state": "translated",
            "value": "The address answers, but has no chat API there. Check that it ends in /v1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5730\u5740\u80fd\u8fde\u4e0a\uff0c\u4f46\u6ca1\u6709\u627e\u5230\u5bf9\u8bdd\u63a5\u53e3\uff0c\u8bf7\u786e\u8ba4\u5730\u5740\u4ee5 /v1 \u7ed3\u5c3e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5730\u5740\u53ef\u4ee5\u9023\u4e0a\uff0c\u4f46\u6c92\u6709\u627e\u5230\u5c0d\u8a71 API\uff0c\u8acb\u78ba\u8a8d\u5730\u5740\u4ee5 /v1 \u7d50\u5c3e\u3002"
          }
        }
      }
    },
    "The agent acted %@ s ago. Install opens a minute after its last step.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u5728 %@ \u79d2\u524d\u6267\u884c\u8fc7\u64cd\u4f5c\u3002\u6700\u540e\u4e00\u6b65\u5b8c\u6210 1 \u5206\u949f\u540e\u5373\u53ef\u5b89\u88c5\u3002"
