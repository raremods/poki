    "As reported by users of %@ and not checked against its documentation. The status on the Loopback page tells whether it works.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6765\u81ea %@ \u7528\u6237\u7684\u53cd\u9988\uff0c\u672a\u4e0e\u5176\u6587\u6863\u6838\u5bf9\u3002\u201c\u56de\u73af\u201d\u9875\u9762\u4e0a\u7684\u72b6\u6001\u4f1a\u663e\u793a\u5b83\u662f\u5426\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f86\u81ea %@ \u4f7f\u7528\u8005\u7684\u53cd\u994b\uff0c\u672a\u8207\u5176\u6587\u4ef6\u6838\u5c0d\u3002\u300c\u8ff4\u74b0\u300d\u9801\u9762\u4e0a\u7684\u72c0\u614b\u6703\u986f\u793a\u5b83\u662f\u5426\u53ef\u7528\u3002"
          }
        }
      }
    },
