    "Pairing on the phone itself needs iOS 27, and this iPhone runs iOS %@. Pair it from a computer instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u6539\u7528\u7535\u8111\u914d\u5bf9\u3002\u672c\u673a\u76f4\u63a5\u914d\u5bf9\u9700\u8981 iOS 27\uff0c\u5f53\u524d\u7cfb\u7edf\u4e3a iOS %@\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u6539\u7528\u96fb\u8166\u914d\u5c0d\u3002\u672c\u6a5f\u76f4\u63a5\u914d\u5c0d\u9700\u8981 iOS 27\uff0c\u76ee\u524d\u7cfb\u7d71\u70ba iOS %@\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair from a computer instead. On-device pairing requires iOS 27, and this iPhone runs iOS %@."
          }
        }
      }
    },
