        }
      }
    },
    "the request failed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u6c42\u5931\u8d25\u3002"
          }
        }
      }
    },
    "\u201cText Mom I\u2019m on my way.\u201d": {
      "localizations": {
