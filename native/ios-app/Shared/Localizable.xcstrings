        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f00\u542f\u5f00\u53d1\u8005\u6a21\u5f0f\uff0c\u8def\u5f84\u662f\u8bbe\u7f6e \u203a \u9690\u79c1\u4e0e\u5b89\u5168 \u203a \u5f00\u53d1\u8005\u6a21\u5f0f\uff0c\u7136\u540e\u91cd\u542f\u624b\u673a\u3002"
