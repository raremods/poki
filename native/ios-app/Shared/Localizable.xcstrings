        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u8207 Qeno \u76f8\u540c\u7684\u7c3d\u540d\u5de5\u5177\u548c Apple ID \u5b89\u88dd Qeno Runner\uff08poki-runner-unsigned.ipa\uff09\uff0c\u7136\u5f8c\u5728\u300c\u8a2d\u5b9a \u203a \u901a\u7528 \u203a VPN \u8207\u88dd\u7f6e\u7ba1\u7406\u300d\u4e2d\u4fe1\u4efb\u5b83\u7684\u958b\u767c\u8005\u3002"
