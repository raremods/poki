        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u652f\u63f4\u5169\u7a2e\u66f4\u65b0\u65b9\u5f0f\uff1a\u767b\u5165\u5e33\u865f\u5728\u6b64\u76f4\u63a5\u66f4\u65b0\uff0c\u6216\u9023\u7dda Mac \u4f7f\u7528 Qeno Setup \u66f4\u65b0\u3002"
