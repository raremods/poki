    "The agent can't act on this screen. It waits for you.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u754c\u9762\u9700\u4f60\u4eb2\u81ea\u64cd\u4f5c\uff0c\u667a\u80fd\u4f53\u7b49\u5f85\u4e2d\u3002"
