    "The voice connection could not reach OpenAI over this network. Check Wi-Fi or cellular, or a VPN or proxy app that blocks calls, then try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u68c0\u67e5 Wi-Fi\u3001\u8702\u7a9d\u7f51\u7edc\u6216\u62e6\u622a\u901a\u8bdd\u7684 VPN/\u4ee3\u7406\u540e\u91cd\u8bd5\u3002\u5f53\u524d\u7f51\u7edc\u65e0\u6cd5\u8fde\u63a5 OpenAI \u8bed\u97f3\u670d\u52a1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u6aa2\u67e5 Wi-Fi\u3001\u884c\u52d5\u7db2\u8def\u6216\u6514\u622a\u901a\u8a71\u7684 VPN/\u4ee3\u7406\u5f8c\u91cd\u8a66\u3002\u76ee\u524d\u7db2\u8def\u7121\u6cd5\u9023\u7dda OpenAI \u8a9e\u97f3\u670d\u52d9\u3002"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check Wi-Fi, cellular, or any VPN/proxy blocking calls, then try again. Voice couldn\u2019t reach OpenAI on this network."
          }
        }
      }
    },
    "Thinking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
