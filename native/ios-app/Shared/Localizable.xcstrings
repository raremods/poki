            "value": "\u7b2c %lld \u6b65\uff08\u201c%@\u201d\uff09"
          }
        }
      }
    },
    "Step 3 of 4, in Messages": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b2c 3/4 \u6b65\uff08\u201c\u4fe1\u606f\u201d\uff09"
          }
        }
      }
    },
    "Steps from your agent appear here and on the Lock Screen.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u7684\u64cd\u4f5c\u6b65\u9aa4\u4f1a\u663e\u793a\u5728\u6b64\u5904\u548c\u9501\u5b9a\u5c4f\u5e55\u4e0a\u3002"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62"
          }
        }
      }
    },
    "Stop Qeno and finish pairing before changing the local connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f4\u6539\u672c\u673a\u8fde\u63a5\u524d\uff0c\u8bf7\u5148\u5173\u95ed Qeno \u5e76\u5b8c\u6210\u914d\u5bf9\u3002"
          }
        }
      }
    },
    "Stop Runner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62 Runner"
          }
        }
      }
    },
    "Stop When Idle For": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95f2\u7f6e\u591a\u4e45\u540e\u505c\u6b62"
          }
        }
      }
    },
    "Stop runner": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62 Runner"
          }
        }
      }
    },
    "Stop talking": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u65ad\u64ad\u62a5"
          }
        }
      }
    },
    "Stop talking ends Qeno's reply; a step already running on the phone still finishes and Qeno tells you how it went.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u65ad\u64ad\u62a5\u4ec5\u505c\u6b62\u8bed\u97f3\u56de\u590d\uff0c\u5f53\u524d\u6b63\u5728\u6267\u884c\u7684\u64cd\u4f5c\u4ecd\u4f1a\u5b8c\u6210\u5e76\u5411\u4f60\u53cd\u9988\u7ed3\u679c\u3002"
          }
        }
      }
    },
    "Stopped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u505c\u6b62"
          }
        }
      }
    },
    "Stopped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u505c\u6b62\u3002"
          }
        }
      }
    },
    "Switch Back When Finished": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u6210\u540e\u5207\u6362\u56de\u539f\u952e\u76d8"
          }
        }
      }
    },
    "Switch to It Automatically": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u52a8\u5207\u6362\u5230 Qeno \u952e\u76d8"
          }
        }
      }
    },
    "System Pinyin Keyboard for Chinese": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u7cfb\u7edf\u62fc\u97f3\u952e\u76d8\u8f93\u5165\u4e2d\u6587"
          }
        }
      }
    },
    "THIS IPHONE": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone"
          }
        }
      }
    },
    "Talk to Qeno": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0e Qeno \u8bed\u97f3\u5bf9\u8bdd"
          }
        }
      }
    },
    "Tap **Pair with Qeno** and enter the code shown here and on the Lock Screen.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u201c**\u4e0e Qeno \u914d\u5bf9**\u201d\uff0c\u5e76\u8f93\u5165\u6b64\u5904\u6216\u9501\u5b9a\u5c4f\u5e55\u4e0a\u663e\u793a\u7684\u914d\u5bf9\u7801\u3002"
          }
        }
      }
    },
    "Tap **Qeno** in that list and turn on **Allow Full Access**.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5217\u8868\u4e2d\u8f7b\u70b9 **Qeno**\uff0c\u6253\u5f00**\u5141\u8bb8\u5b8c\u5168\u8bbf\u95ee**\u3002"
          }
        }
      }
    },
    "Tap Install Module, then confirm in Surge.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u201c\u5b89\u88c5\u6a21\u5757\u201d\uff0c\u7136\u540e\u5728 Surge \u4e2d\u786e\u8ba4\u3002"
          }
        }
      }
    },
    "Tap Install Plugin, then confirm in Loon.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u201c\u5b89\u88c5\u63d2\u4ef6\u201d\uff0c\u7136\u540e\u5728 Loon \u4e2d\u786e\u8ba4\u3002"
          }
        }
      }
    },
    "Tap Send": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u201c\u53d1\u9001\u201d"
          }
        }
      }
    },
    "Tap Start, leave the app for a while, then return. The log records suspension gaps and connection closures.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u201c\u5f00\u59cb\u201d\uff0c\u79bb\u5f00 App \u4e00\u6bb5\u65f6\u95f4\u540e\u518d\u8fd4\u56de\u3002\u65e5\u5fd7\u4f1a\u8bb0\u5f55\u6302\u8d77\u65f6\u6bb5\u53ca\u8fde\u63a5\u65ad\u5f00\u7684\u65f6\u95f4\u3002"
          }
        }
      }
    },
    "Tap the chat with Mom": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u4e0e\u5988\u5988\u7684\u5bf9\u8bdd"
          }
        }
      }
    },
    "Tap \u201cSend\u201d": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f7b\u70b9\u201c\u53d1\u9001\u201d"
          }
        }
      }
    },
    "Taps and types on this iPhone for you": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ff\u4f60\u5728\u8fd9\u53f0 iPhone \u4e0a\u70b9\u6309\u548c\u6253\u5b57"
          }
        }
      }
    },
    "Testing Options": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6d4b\u8bd5\u9009\u9879"
          }
        }
      }
    },
    "Text Entry": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6587\u5b57\u8f93\u5165\u65b9\u5f0f"
          }
        }
      }
    },
    "Text Mom\nI\u2019m on my way\u2026": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u544a\u8bc9\u5988\u5988\n\u6211\u5728\u8def\u4e0a\u4e86\u2026"
          }
        }
      }
    },
    "Text Mom \u201cOn my way\u201d": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ed9\u5988\u5988\u53d1\u6d88\u606f\u201c\u5728\u8def\u4e0a\u4e86\u201d"
          }
        }
      }
    },
    "That is not a relay address. Enter the address deploy.sh printed, such as https://poki-relay.you.workers.dev.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u4e0d\u662f\u4e2d\u8f6c\u5730\u5740\u3002\u8bf7\u8f93\u5165 deploy.sh \u8f93\u51fa\u7684\u5730\u5740\uff0c\u4f8b\u5982 https://poki-relay.you.workers.dev\u3002"
          }
        }
      }
    },
    "That is not a voice bridge address. It looks like http://192.168.1.10:47830/voice/ followed by a long code.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bed\u97f3\u6865\u63a5\u5730\u5740\u683c\u5f0f\u6709\u8bef\u3002\u6b63\u786e\u683c\u5f0f\u793a\u4f8b\uff1ahttp://192.168.1.10:47830/voice/ \u540e\u63a5\u4e00\u4e32\u5b57\u7b26\u3002"
          }
        }
      }
    },
    "The Live Activity did not start: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9e\u65f6\u6d3b\u52a8\u672a\u80fd\u542f\u52a8\uff1a%@"
          }
        }
      }
    },
    "The answer was cut off.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u590d\u5df2\u622a\u65ad\u3002"
          }
        }
      }
    },
    "The approval ran out, so Qeno skipped that step": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6279\u51c6\u8d85\u65f6\uff0c\u5df2\u8df3\u8fc7\u6b64\u6b65\u9aa4"
          }
        }
      }
    },
    "The built-in connection runs on a physical iPhone. External connection options are shown below.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5185\u7f6e\u8fde\u63a5\u53ea\u80fd\u5728\u771f\u673a\u4e0a\u8fd0\u884c\u3002\u4e0b\u65b9\u5217\u51fa\u5916\u90e8\u8fde\u63a5\u65b9\u5f0f\u3002"
          }
        }
      }
    },
    "The built-in connection runs on a physical iPhone. Use your proxy app above.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5185\u7f6e\u8fde\u63a5\u53ea\u80fd\u5728\u771f\u673a\u4e0a\u8fd0\u884c\u3002\u8bf7\u4f7f\u7528\u4e0a\u65b9\u7684\u4ee3\u7406 App\u3002"
          }
        }
      }
    },
    "The developer disk image did not install. Qeno downloads it again by itself.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f00\u53d1\u8005\u78c1\u76d8\u6620\u50cf\u672a\u80fd\u5b89\u88c5\uff0cQeno \u4f1a\u81ea\u52a8\u91cd\u65b0\u4e0b\u8f7d\u3002"
          }
        }
      }
    },
    "The developer disk image is not downloaded yet (Setup > Pair). It is needed once.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f00\u53d1\u8005\u78c1\u76d8\u6620\u50cf\u5c1a\u672a\u4e0b\u8f7d\uff08\u8bbe\u7f6e\u5f15\u5bfc \u203a \u914d\u5bf9\uff09\uff0c\u53ea\u9700\u4e0b\u8f7d\u4e00\u6b21\u3002"
          }
        }
      }
    },
    "The first time Qeno Runner starts after a restart, iOS asks for your passcode to allow automation. Enter it once; Qeno never sees it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone \u91cd\u65b0\u542f\u52a8\u540e\u9996\u6b21\u542f\u52a8 Qeno Runner \u65f6\uff0ciOS \u4f1a\u8981\u6c42\u8f93\u5165\u9501\u5c4f\u5bc6\u7801\u4ee5\u5141\u8bb8\u81ea\u52a8\u5316\u64cd\u4f5c\u3002\u53ea\u9700\u8f93\u5165\u4e00\u6b21\uff0cQeno \u65e0\u6cd5\u8bfb\u53d6\u8be5\u5bc6\u7801\u3002"
          }
        }
      }
    },
    "The helper app that taps and types for your agent. Qeno starts it; you never open it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ff\u667a\u80fd\u4f53\u6267\u884c\u8f7b\u70b9\u548c\u8f93\u5165\u7684\u8f85\u52a9 App\u3002\u7531 Qeno \u81ea\u52a8\u542f\u52a8\uff0c\u65e0\u9700\u624b\u52a8\u6253\u5f00\u3002"
          }
        }
      }
    },
    "The keychain did not take the key. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bc6\u94a5\u65e0\u6cd5\u4fdd\u5b58\u81f3\u94a5\u5319\u4e32\uff0c\u8bf7\u91cd\u8bd5\u3002"
          }
        }
      }
    },
    "The keychain did not take the sign-in. Try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u5c06\u767b\u5f55\u4fe1\u606f\u4fdd\u5b58\u5230\u94a5\u5319\u4e32\uff0c\u8bf7\u91cd\u8bd5\u3002"
          }
        }
      }
    },
    "The latest screen": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u65b0\u753b\u9762"
          }
        }
      }
    },
    "The local VPN did not connect within 15 seconds. Try again, or choose an external connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a VPN \u5728 15 \u79d2\u5185\u6ca1\u6709\u8fde\u4e0a\u3002\u8bf7\u91cd\u8bd5\uff0c\u6216\u9009\u62e9\u5916\u90e8\u8fde\u63a5\u3002"
          }
        }
      }
    },
    "The local VPN needs a physical iPhone. Its network connection cannot be tested in the Simulator.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a VPN \u9700\u8981\u771f\u673a\uff0c\u65e0\u6cd5\u5728\u6a21\u62df\u5668\u4e2d\u6d4b\u8bd5\u5b83\u7684\u7f51\u7edc\u8fde\u63a5\u3002"
          }
        }
      }
    },
    "The local connection is off. Turn Qeno on to reconnect, or choose an external connection in Setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a\u8fde\u63a5\u5df2\u5173\u95ed\u3002\u5f00\u542f Qeno \u5373\u53ef\u91cd\u65b0\u8fde\u63a5\uff0c\u6216\u5728\u8bbe\u7f6e\u5f15\u5bfc\u4e2d\u9009\u62e9\u5916\u90e8\u8fde\u63a5\u3002"
          }
        }
      }
    },
    "The local connection is still stopping. Try again in a moment.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a\u8fde\u63a5\u4ecd\u5728\u505c\u6b62\u4e2d\uff0c\u8bf7\u7a0d\u540e\u518d\u8bd5\u3002"
          }
        }
      }
    },
    "The local interface is present, but this iPhone does not answer at 10.7.0.1. Reconnect the local connection and check Wi-Fi. If it still does not answer, pair again in Setup \u203a Pairing, then check Developer Mode.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a\u63a5\u53e3\u5df2\u5b58\u5728\uff0c\u4f46\u6b64 iPhone \u5728 10.7.0.1 \u6ca1\u6709\u5e94\u7b54\u3002\u8bf7\u91cd\u65b0\u8fde\u63a5\u672c\u673a\u8fde\u63a5\u5e76\u68c0\u67e5\u65e0\u7ebf\u5c40\u57df\u7f51\uff1b\u4ecd\u6ca1\u6709\u5e94\u7b54\u65f6\uff0c\u5230\u201c\u8bbe\u7f6e\u5f15\u5bfc \u203a \u914d\u5bf9\u201d\u91cd\u65b0\u914d\u5bf9\uff0c\u7136\u540e\u518d\u68c0\u67e5\u5f00\u53d1\u8005\u6a21\u5f0f\u3002"
          }
        }
      }
    },
    "The local interface is present, but this iPhone's developer services do not answer. Check Developer Mode and Wi-Fi, then reconnect the local connection.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u673a\u63a5\u53e3\u5df2\u5b58\u5728\uff0c\u4f46\u6b64 iPhone \u7684\u5f00\u53d1\u8005\u670d\u52a1\u6ca1\u6709\u5e94\u7b54\u3002\u8bf7\u68c0\u67e5\u5f00\u53d1\u8005\u6a21\u5f0f\u548c\u65e0\u7ebf\u5c40\u57df\u7f51\uff0c\u7136\u540e\u91cd\u65b0\u8fde\u63a5\u672c\u673a\u8fde\u63a5\u3002"
          }
        }
      }
    },
    "The model declined this request.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a21\u578b\u65e0\u6cd5\u5904\u7406\u6b64\u8bf7\u6c42\u3002"
          }
        }
      }
    },
    "The phone no longer accepts Qeno\u2019s pairing (%@). Pair again in Setup; it takes a minute.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone \u4e0d\u518d\u63a5\u53d7 Qeno \u7684\u914d\u5bf9\uff08%@\uff09\u3002\u8bf7\u5728\u8bbe\u7f6e\u5f15\u5bfc\u4e2d\u91cd\u65b0\u914d\u5bf9\uff0c\u53ea\u9700\u4e00\u5206\u949f\u3002"
          }
        }
      }
    },
    "The phone no longer accepts this pairing: %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone \u4e0d\u518d\u63a5\u53d7\u5f53\u524d\u914d\u5bf9\uff1a%@"
          }
        }
      }
    },
    "The phone refused the pairing.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u624b\u673a\u62d2\u7edd\u4e86\u914d\u5bf9\u3002"
          }
        }
      }
    },
    "The relay forwards requests to this iPhone while Qeno is open or in the background. It stores nothing; when offline, clients receive an error.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53 Qeno \u6253\u5f00\u6216\u5728\u540e\u53f0\u8fd0\u884c\u65f6\uff0c\u4e2d\u8f6c\u670d\u52a1\u5668\u4f1a\u5c06\u8bf7\u6c42\u8f6c\u53d1\u81f3\u6b64 iPhone\u3002\u670d\u52a1\u5668\u4e0d\u5b58\u50a8\u4efb\u4f55\u6570\u636e\uff1b\u8bbe\u5907\u79bb\u7ebf\u65f6\uff0c\u5ba2\u6237\u7aef\u4f1a\u6536\u5230\u660e\u786e\u7684\u9519\u8bef\u63d0\u793a\u3002"
          }
        }
      }
    },
    "The runner starts when an agent asks.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u53d1\u51fa\u8bf7\u6c42\u65f6\uff0cRunner \u4f1a\u81ea\u52a8\u542f\u52a8\u3002"
          }
        }
      }
    },
    "The runner stopped": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Runner \u5df2\u505c\u6b62"
          }
        }
      }
    },
    "The sign-in code ran out. Start again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u767b\u5f55\u7801\u5df2\u8fc7\u671f\uff0c\u8bf7\u91cd\u8bd5\u3002"
          }
        }
      }
    },
    "The system Pinyin keyboard is slower and reads the screen while it types.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cfb\u7edf\u62fc\u97f3\u952e\u76d8\u8f83\u6162\uff0c\u5e76\u4e14\u8f93\u5165\u65f6\u4f1a\u8bfb\u53d6\u5c4f\u5e55\u3002"
          }
        }
      }
    },
    "This Anthropic key can\u2019t use %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 Anthropic \u5bc6\u94a5\u4e0d\u652f\u6301\u8c03\u7528 %@\u3002"
          }
        }
      }
    },
    "This OpenAI key can\u2019t use %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 OpenAI \u5bc6\u94a5\u65e0\u6743\u8c03\u7528 %@\u3002"
          }
        }
      }
    },
    "This OpenAI key has no credit left. Check billing at platform.openai.com.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 OpenAI \u5bc6\u94a5\u989d\u5ea6\u4e0d\u8db3\uff0c\u8bf7\u524d\u5f80 platform.openai.com \u67e5\u770b\u8d26\u5355\u3002"
          }
        }
      }
    },
    "This build has no local VPN. Choose an external connection, or install the build with the local VPN and supported signing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u7248\u672c\u6ca1\u6709\u672c\u673a VPN\u3002\u8bf7\u9009\u62e9\u5916\u90e8\u8fde\u63a5\uff0c\u6216\u5b89\u88c5\u5e26\u672c\u673a VPN \u4e14\u7b7e\u540d\u53d7\u652f\u6301\u7684\u7248\u672c\u3002"
          }
        }
      }
    },
    "This build uses an external connection. For the built-in connection, install the local-VPN build with signing that supports Network Extensions.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u7248\u672c\u4f7f\u7528\u5916\u90e8\u8fde\u63a5\u3002\u5982\u9700\u5185\u7f6e\u8fde\u63a5\uff0c\u8bf7\u5b89\u88c5\u5e26\u672c\u673a VPN \u7684\u7248\u672c\uff0c\u5e76\u4f7f\u7528\u652f\u6301\u7f51\u7edc\u6269\u5c55\u7684\u7b7e\u540d\u3002"
          }
        }
      }
    },
    "This happens after a restore, a reset of Location & Privacy, or when the phone forgot Qeno. Pair again; the old key is replaced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d iPhone\u3001\u8fd8\u539f\u201c\u4f4d\u7f6e\u4e0e\u9690\u79c1\u201d\u6216 iPhone \u5fd8\u8bb0 Qeno \u540e\u4f1a\u51fa\u73b0\u8fd9\u79cd\u60c5\u51b5\u3002\u91cd\u65b0\u914d\u5bf9\u5373\u53ef\uff0c\u65e7\u5bc6\u94a5\u4f1a\u88ab\u66ff\u6362\u3002"
          }
        }
      }
    },
    "This iOS version needs a newer developer disk image. Open Qeno's setup to download the latest image, or update Qeno.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iOS \u7248\u672c\u9700\u8981\u66f4\u65b0\u7684\u5f00\u53d1\u8005\u78c1\u76d8\u6620\u50cf\u3002\u8bf7\u6253\u5f00 Qeno \u7684\u8bbe\u7f6e\u5f15\u5bfc\u4e0b\u8f7d\u6700\u65b0\u6620\u50cf\uff0c\u6216\u66f4\u65b0 Qeno\u3002"
          }
        }
      }
    },
    "This iPhone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone"
          }
        }
      }
    },
    "This iPhone answers at 10.7.0.1 (%lld ms).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone \u5728 10.7.0.1 \u5e94\u7b54\uff08%lld \u6beb\u79d2\uff09\u3002"
          }
        }
      }
    },
    "This iPhone does not answer yet. Enable Qeno's local connection, or choose an external connection in Setup.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone \u8fd8\u6ca1\u6709\u5e94\u7b54\u3002\u8bf7\u5f00\u542f Qeno \u7684\u672c\u673a\u8fde\u63a5\uff0c\u6216\u5728\u8bbe\u7f6e\u5f15\u5bfc\u4e2d\u9009\u62e9\u5916\u90e8\u8fde\u63a5\u3002"
          }
        }
      }
    },
    "This iPhone is ready for Qeno": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64 iPhone \u5df2\u53ef\u4f9b Qeno \u4f7f\u7528"
          }
        }
      }
    },
    "Timeout": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d85\u65f6"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u5929"
          }
        }
      }
    },
    "Try Again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u8bd5"
          }
        }
      }
    },
