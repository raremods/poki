          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u4f60\u7684\u4ee3\u7406 App"
          }
        }
      }
    },
    "Up to Date": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u662f\u6700\u65b0"
          }
        }
      }
    },
    "Update Available": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u53ef\u7528\u66f4\u65b0"
          }
        }
      }
    },
    "Update iOS to 17.4 or later.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u628a iOS \u66f4\u65b0\u5230 17.4 \u6216\u66f4\u9ad8\u7248\u672c\u3002"
