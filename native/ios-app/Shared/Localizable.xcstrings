        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5728\u201c\u8bbe\u7f6e \u203a \u4e2d\u8f6c\u201d\u4e2d\u8f93\u5165\u4f60\u7684\u4e2d\u8f6c\u5730\u5740\u3002Qeno \u6ca1\u6709\u9ed8\u8ba4\u4e2d\u8f6c\u3002"
